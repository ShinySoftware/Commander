<Project Sdk="Microsoft.NET.Sdk">
    <!-- macOS head on the maui-labs native AppKit backend (not Mac Catalyst) -->
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)-macos</TargetFramework>
        <OutputType>Exe</OutputType>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <AssemblyName>ShinyCommander</AssemblyName>
        <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>

        <ApplicationTitle>ShinyCommander</ApplicationTitle>
        <ApplicationId>org.shiny.commander</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <DefineConstants>$(DefineConstants);MACOS_APPKIT</DefineConstants>

        <!-- Apple silicon only. Left unset, a Release build compiles both architectures and lipos them into one
             universal bundle, and the osx-arm64 folder is an unsigned intermediate. The bundle to ship is then
             bin/Release/net10.0-macos/osx-arm64/ShinyCommander.app; publish without -o, which splits it. -->
        <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    </PropertyGroup>

    <!-- Distribution outside the App Store: Developer ID signing with the hardened runtime, which notarization
         requires. CI passes CodesignKey; local Release builds without it stay ad-hoc signed, and without the hardened
         runtime: its library validation refuses ad-hoc signed dylibs (each is a "different team"), so an ad-hoc
         hardened build dies in dyld before it starts. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
        <UseHardenedRuntime Condition="'$(CodesignKey)' != ''">true</UseHardenedRuntime>
        <EnableCodeSigning>true</EnableCodeSigning>
    </PropertyGroup>

    <Import Project="..\ShinyCommander.Shared\ShinyCommander.Shared.props" />

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Platforms.MacOS" />
        <PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials" />
    </ItemGroup>

    <ItemGroup>
        <!-- the Shiny mark on a dark tile (tools/appicon.py); maui-labs turns it into AppIcon.icns -->
        <MauiIcon Include="..\ShinyCommander.Shared\Resources\AppIcon\appicon.png" />
        <!-- maui-labs writes this key in a partial plist that never reaches Info.plist, so the icon wouldn't show -->
        <PartialAppManifest Include="AppIcon.plist" />
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <!-- the DevFlow agent is referenced in Debug - enables the UI test hooks (Shared/Testing) -->
        <DefineConstants>$(DefineConstants);SHINYCOMMANDER_DEVFLOW</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <PackageReference Include="Microsoft.Maui.DevFlow.Agent" />
    </ItemGroup>
</Project>
