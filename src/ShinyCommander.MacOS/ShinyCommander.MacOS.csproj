<Project Sdk="Microsoft.NET.Sdk">
    <!-- macOS head on the maui-labs native AppKit backend (not Mac Catalyst) -->
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)-macos</TargetFramework>
        <OutputType>Exe</OutputType>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <AssemblyName>ShinyCommander</AssemblyName>
        <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>

        <ApplicationTitle>ShinyCommander</ApplicationTitle>
        <ApplicationId>org.shiny.commander</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <DefineConstants>$(DefineConstants);MACOS_APPKIT</DefineConstants>
    </PropertyGroup>

    <Import Project="..\ShinyCommander.Shared\ShinyCommander.Shared.props" />

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Platforms.MacOS" />
        <PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials" />
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <!-- the DevFlow agent is referenced in Debug - enables the UI test hooks (Shared/Testing) -->
        <DefineConstants>$(DefineConstants);SHINYCOMMANDER_DEVFLOW</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <PackageReference Include="Microsoft.Maui.DevFlow.Agent" />
    </ItemGroup>
</Project>
