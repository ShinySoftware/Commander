<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:md="http://shiny.net/maui/markdown"
             x:Class="ShinyCommander.Views.UpdatePage"
             Title="ShinyCommander Update"
             BackgroundColor="{AppThemeBinding Light={StaticResource PanelLight}, Dark={StaticResource PanelDark}}">

    <!-- the progress and the error line are on the page from the start and only shown when needed:
         the AppKit head never realises views added to a page that is already on screen -->
    <Grid Padding="24,20" RowSpacing="14" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">
        <VerticalStackLayout Spacing="4">
            <Label Text="A new version of ShinyCommander is available" FontSize="20" FontAttributes="Bold" />
            <Label x:Name="VersionLabel" Style="{StaticResource Subtle}" FontSize="13" />
            <Label x:Name="ReleasedLabel" Style="{StaticResource Subtle}" />
        </VerticalStackLayout>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <md:MarkdownView x:Name="Notes" Theme="{AppThemeBinding Light={StaticResource MarkdownLight}, Dark={StaticResource MarkdownDark}}" Padding="14,10" />
        </Border>

        <Label Grid.Row="2" Text="View on GitHub" TextColor="{StaticResource Accent}" FontSize="12">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnGitHubTapped" />
            </Label.GestureRecognizers>
        </Label>

        <shiny:ProgressBar x:Name="Progress" Grid.Row="3" Maximum="1" TrackHeight="5" IsVisible="False" />
        <Label x:Name="Status" Grid.Row="4" Style="{StaticResource Subtle}" IsVisible="False" />

        <Grid Grid.Row="5" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
            <CheckBox x:Name="DontShow" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="Don't show again" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDontShowTapped" />
                </Label.GestureRecognizers>
            </Label>
            <shiny:ShinyButton x:Name="LaterButton" Grid.Column="3" Text="Later" Appearance="Tonal" Clicked="OnLaterClicked" />
            <shiny:ShinyButton x:Name="InstallButton" Grid.Column="4" Text="Install and Restart" Appearance="Filled" Clicked="OnInstallClicked" />
        </Grid>
    </Grid>
</ContentPage>
