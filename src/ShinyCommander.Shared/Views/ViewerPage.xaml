<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:md="http://shiny.net/maui/markdown"
             xmlns:vm="clr-namespace:ShinyCommander.ViewModels"
             xmlns:l="clr-namespace:ShinyCommander"
             x:Class="ShinyCommander.Views.ViewerPage"
             x:DataType="vm:ViewerViewModel">

    <shiny:KeyboardShortcuts.Shortcuts>
        <shiny:KeyboardShortcut Gesture="Escape" Command="{Binding CloseCommand}" Description="{l:Tr Common_Close}" />
        <shiny:KeyboardShortcut Gesture="F3" Command="{Binding CloseCommand}" Description="{l:Tr Common_Close}" />
        <shiny:KeyboardShortcut Gesture="Q" Command="{Binding CloseCommand}" Description="{l:Tr Common_Close}" />
        <shiny:KeyboardShortcut Gesture="1" Command="{Binding SetModeCommand}" CommandParameter="Text" Description="{l:Tr Viewer_ModeText}" />
        <shiny:KeyboardShortcut Gesture="3" Command="{Binding SetModeCommand}" CommandParameter="Hex" Description="{l:Tr Viewer_ModeHex}" />
        <shiny:KeyboardShortcut Gesture="4" Command="{Binding SetModeCommand}" CommandParameter="Markdown" Description="{l:Tr Viewer_ModeMarkdown}" />
        <shiny:KeyboardShortcut Gesture="W" Command="{Binding ToggleWrapCommand}" Description="{l:Tr Viewer_WordWrap}" />
        <shiny:KeyboardShortcut Gesture="N" Command="{Binding NextFileCommand}" Description="{l:Tr Viewer_NextFile}" />
        <shiny:KeyboardShortcut Gesture="P" Command="{Binding PreviousFileCommand}" Description="{l:Tr Viewer_PreviousFile}" />
    </shiny:KeyboardShortcuts.Shortcuts>

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" Style="{StaticResource Toolbar}" Padding="10,6" HeightRequest="44" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <shiny:ShinyButton AutomationId="PageBack" Text="{l:Tr Page_Back}" Command="{Binding CloseCommand}" Appearance="Text" FontSize="12" ContentPadding="6,2" />
            <Label Grid.Column="1" Text="{Binding Title}" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" LineBreakMode="MiddleTruncation" />
            <HorizontalStackLayout Grid.Column="2" Spacing="4">
                <shiny:ShinyButton Text="{l:Tr Viewer_TextButton}" Command="{Binding SetModeCommand}" CommandParameter="Text" Appearance="Text" FontSize="12" ContentPadding="6,2" />
                <shiny:ShinyButton Text="{l:Tr Viewer_HexButton}" Command="{Binding SetModeCommand}" CommandParameter="Hex" Appearance="Text" FontSize="12" ContentPadding="6,2" />
                <shiny:ShinyButton Text="{l:Tr Viewer_MarkdownButton}" Command="{Binding SetModeCommand}" CommandParameter="Markdown" Appearance="Text" FontSize="12" ContentPadding="6,2" />
                <shiny:ShinyButton Text="{l:Tr Viewer_WrapButton}" Command="{Binding ToggleWrapCommand}" Appearance="Text" FontSize="12" ContentPadding="6,2" />
                <shiny:ShinyButton Text="{l:Tr Viewer_PrevButton}" Command="{Binding PreviousFileCommand}" Appearance="Text" FontSize="12" ContentPadding="6,2" />
                <shiny:ShinyButton Text="{l:Tr Viewer_NextButton}" Command="{Binding NextFileCommand}" Appearance="Text" FontSize="12" ContentPadding="6,2" />
            </HorizontalStackLayout>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="8" Padding="0">
            <Grid>
                <ScrollView IsVisible="{Binding IsText}" Orientation="Both">
                    <!-- Margin, not the ScrollView's Padding: AppKit ignores scroll view padding -->
                    <Label x:Name="TextLabel"
                           Margin="14,10"
                           Text="{Binding Text}"
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="{Binding FontSize}" />
                </ScrollView>

                <Image IsVisible="{Binding IsImage}" Source="{Binding Image}" Aspect="AspectFit" Margin="10" />

                <md:MarkdownView Theme="{AppThemeBinding Light={StaticResource MarkdownLight}, Dark={StaticResource MarkdownDark}}" IsVisible="{Binding IsMarkdown}" Markdown="{Binding Text, Converter={StaticResource MarkdownHeadings}}" Padding="16" />

                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" Color="{StaticResource Accent}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Style="{StaticResource Toolbar}" Padding="10,4">
            <Label Text="{Binding Info}" Style="{StaticResource Subtle}" />
        </Grid>
    </Grid>
</ContentPage>
