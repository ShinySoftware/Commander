<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:vm="clr-namespace:ShinyCommander.ViewModels"
             xmlns:l="clr-namespace:ShinyCommander"
             x:Class="ShinyCommander.Views.SearchPage"
             x:DataType="vm:SearchViewModel">

    <shiny:KeyboardShortcuts.Shortcuts>
        <shiny:KeyboardShortcut Gesture="Escape" Command="{Binding CloseCommand}" Description="{l:Tr Common_Close}" />
        <shiny:KeyboardShortcut Gesture="Primary+Enter" Command="{Binding StartCommand}" Description="{l:Tr Search_StartStop}" />
        <shiny:KeyboardShortcut Gesture="F3" Command="{Binding ViewFileCommand}" Description="{l:Tr Search_View}" />
        <shiny:KeyboardShortcut Gesture="Primary+G" Command="{Binding GoToFileCommand}" Description="{l:Tr Search_GoToFile}" />
    </shiny:KeyboardShortcuts.Shortcuts>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" Style="{StaticResource Toolbar}" Padding="10,6" HeightRequest="44" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <shiny:ShinyButton AutomationId="PageBack" Text="{l:Tr Page_Back}" Command="{Binding CloseCommand}" Appearance="Text" FontSize="12" ContentPadding="6,2" />
            <Label Grid.Column="1" Text="{l:Tr Search_Title}" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" LineBreakMode="MiddleTruncation" />
            <HorizontalStackLayout Grid.Column="2" Spacing="4">

            </HorizontalStackLayout>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="8,8,8,0" Padding="12">
            <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="34,34,30,40" ColumnSpacing="10" RowSpacing="8">
                <Label Text="{l:Tr Search_SearchIn}" VerticalOptions="Center" />
                <Entry Grid.Column="1" Grid.ColumnSpan="3" AutomationId="SearchPath" Text="{Binding StartPath}" FontFamily="{DynamicResource MonoFont}" />

                <Label Grid.Row="1" Text="{l:Tr Search_FileName}" VerticalOptions="Center" />
                <Entry x:Name="MaskEntry" AutomationId="SearchMask" Grid.Row="1" Grid.Column="1" Text="{Binding NameMask}" Placeholder="*.cs;*.xaml | bin/ obj/" ReturnCommand="{Binding StartCommand}" />
                <Label Grid.Row="1" Grid.Column="2" Text="{l:Tr Search_ContainingText}" VerticalOptions="Center" />
                <Entry Grid.Row="1" Grid.Column="3" Text="{Binding ContainingText}" Placeholder="{l:Tr Search_Optional}" ReturnCommand="{Binding StartCommand}" />

                <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="4" Spacing="16">
                    <HorizontalStackLayout Spacing="2"><CheckBox IsChecked="{Binding Recursive}" /><Label Text="{l:Tr Search_Subfolders}" VerticalOptions="Center" /></HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="2"><CheckBox IsChecked="{Binding CaseSensitive}" /><Label Text="{l:Tr Search_CaseSensitive}" VerticalOptions="Center" /></HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="2"><CheckBox IsChecked="{Binding IncludeHidden}" /><Label Text="{l:Tr Search_HiddenFiles}" VerticalOptions="Center" /></HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="2"><CheckBox IsChecked="{Binding FoldersOnly}" /><Label Text="{l:Tr Search_FoldersOnly}" VerticalOptions="Center" /></HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6"><Label Text="{l:Tr Search_MinSize}" VerticalOptions="Center" /><Entry Text="{Binding MinSizeKb}" WidthRequest="80" Keyboard="Numeric" /></HorizontalStackLayout>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Row="3" Grid.ColumnSpan="4" Spacing="8">
                    <shiny:ShinyButton AutomationId="SearchStart" Text="{Binding StartText}" Command="{Binding StartCommand}" Appearance="Filled" ContentPadding="18,4" />
                    <shiny:ShinyButton Text="{l:Tr Search_GoToFile}" Command="{Binding GoToFileCommand}" Appearance="Tonal" ContentPadding="12,4" />
                    <shiny:ShinyButton Text="{l:Tr Search_ViewF3}" Command="{Binding ViewFileCommand}" Appearance="Tonal" ContentPadding="12,4" />
                    <ActivityIndicator IsRunning="{Binding IsSearching}" IsVisible="{Binding IsSearching}" Color="{StaticResource Accent}" HeightRequest="18" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="8" Padding="0">
            <shiny:DataGrid ItemsSource="{Binding Results}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                            SortMode="Single"
                            AllowColumnResize="True"
                            Dense="True"
                            Striped="True"
                            EmptyText="{l:Tr Search_NoResults}">
                <shiny:DataGridTemplateColumn Title="" Width="34" Sortable="False">
                    <shiny:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SearchResultItem">
                            <shiny:MotionIconView Icon="{Binding MotionIcon}" Color="{Binding IconColor}" Trigger="Hover" StrokeWidth="2" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center" />
                        </DataTemplate>
                    </shiny:DataGridTemplateColumn.CellTemplate>
                </shiny:DataGridTemplateColumn>
                <shiny:DataGridColumn Title="{l:Tr Search_ColName}" PropertyName="Name" Width="2*" />
                <shiny:DataGridColumn Title="{l:Tr Search_ColFolder}" PropertyName="Folder" Width="3*" />
                <shiny:DataGridColumn Title="{l:Tr Search_ColSize}" PropertyName="Size" Width="100" StringFormat="{}{0:N0}" />
                <shiny:DataGridColumn Title="{l:Tr Search_ColModified}" PropertyName="Modified" Width="150" StringFormat="{}{0:yyyy-MM-dd HH:mm}" />
            </shiny:DataGrid>
        </Border>

        <Grid Grid.Row="3" Style="{StaticResource Toolbar}" Padding="10,4">
            <Label Text="{Binding Status}" Style="{StaticResource Subtle}" LineBreakMode="MiddleTruncation" />
        </Grid>
    </Grid>
</ContentPage>
