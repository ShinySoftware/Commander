<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:vm="clr-namespace:ShinyCommander.ViewModels"
             xmlns:l="clr-namespace:ShinyCommander"
             x:Class="ShinyCommander.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel">

    <shiny:KeyboardShortcuts.Shortcuts>
        <shiny:KeyboardShortcut Gesture="Escape" Command="{Binding CloseCommand}" Description="{l:Tr Common_Close}" />
    </shiny:KeyboardShortcuts.Shortcuts>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Style="{StaticResource Toolbar}" Padding="10,6" HeightRequest="44" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <shiny:ShinyButton AutomationId="PageBack" Text="{l:Tr Page_Back}" Command="{Binding CloseCommand}" Appearance="Text" FontSize="12" ContentPadding="6,2" />
            <Label Grid.Column="1" Text="{l:Tr Settings_Title}" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="1" HorizontalOptions="Center" WidthRequest="680" Padding="0,8">
            <shiny:TableView CellAccentColor="{StaticResource Accent}"
                             CellBackgroundColor="{AppThemeBinding Light={StaticResource PanelLight}, Dark={StaticResource PanelDark}}"
                             CellTitleColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}"
                             CellDescriptionColor="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}"
                             CellValueTextColor="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}"
                             CellTitleFontSize="13"
                             CellDescriptionFontSize="11"
                             CellValueTextFontSize="13"
                             SeparatorColor="{AppThemeBinding Light=#E6E9EE, Dark=#2C3036}"
                             SeparatorPadding="16"
                             HeaderBackgroundColor="Transparent"
                             HeaderTextColor="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}"
                             HeaderFontSize="11"
                             HeaderFontAttributes="Bold"
                             HeaderPadding="16,18,16,6"
                             ShowSectionSeparator="False">
                <shiny:TableRoot>
                    <shiny:TableSection Title="{l:Tr Settings_Panels}">
                        <shiny:SwitchCell Title="{l:Tr Settings_ShowHidden}" Description="{l:Tr Settings_ShowHiddenDesc}" On="{Binding ShowHidden, Mode=TwoWay}" />
                        <shiny:SwitchCell Title="{l:Tr Settings_FriendlySizes}" Description="{l:Tr Settings_FriendlySizesDesc}" On="{Binding FriendlySizes, Mode=TwoWay}" />
                        <shiny:SwitchCell Title="{l:Tr Settings_MotionFileIcons}" Description="{l:Tr Settings_MotionFileIconsDesc}" On="{Binding MotionFileIcons, Mode=TwoWay}" />
                        <shiny:ButtonCell Title="{l:Tr Settings_CustomizeToolbar}" ButtonTextColor="{StaticResource Accent}" Command="{Binding CustomizeToolbarCommand}" />
                    </shiny:TableSection>

                    <shiny:TableSection Title="{l:Tr Settings_Columns}">
                        <shiny:SwitchCell Title="{l:Tr Settings_ColExtension}" On="{Binding ShowExtColumn, Mode=TwoWay}" />
                        <shiny:SwitchCell Title="{l:Tr Settings_ColSize}" On="{Binding ShowSizeColumn, Mode=TwoWay}" />
                        <shiny:SwitchCell Title="{l:Tr Settings_ColModified}" On="{Binding ShowDateColumn, Mode=TwoWay}" />
                        <shiny:SwitchCell Title="{l:Tr Settings_ColCreated}" On="{Binding ShowCreatedColumn, Mode=TwoWay}" />
                        <shiny:SwitchCell Title="{l:Tr Settings_ColAttributes}" On="{Binding ShowAttrColumn, Mode=TwoWay}" />
                    </shiny:TableSection>

                    <shiny:TableSection Title="{l:Tr Settings_Operations}">
                        <shiny:SwitchCell Title="{l:Tr Settings_ConfirmDelete}" On="{Binding ConfirmDelete, Mode=TwoWay}" />
                        <shiny:SwitchCell Title="{l:Tr Settings_UseTrash}" Description="{l:Tr Settings_UseTrashDesc}" On="{Binding UseTrash, Mode=TwoWay}" />
                        <shiny:SwitchCell Title="{l:Tr Settings_ExtractPerArchive}" On="{Binding ExtractToFolderPerArchive, Mode=TwoWay}" />
                        <shiny:EntryCell Title="{l:Tr Settings_ExternalEditor}" Placeholder="{l:Tr Settings_ExternalEditorBuiltIn}" ValueText="{Binding ExternalEditor, Mode=TwoWay}" />
                    </shiny:TableSection>

                    <shiny:TableSection x:Name="LanguageSection" Title="{l:Tr Settings_Language}" shiny:RadioCell.SelectedValue="{Binding Language, Mode=TwoWay}">
                        <shiny:RadioCell Title="{l:Tr Settings_LanguageSystem}" Value="System" />
                        <shiny:RadioCell Title="English" Value="en" />
                        <shiny:RadioCell Title="Français" Value="fr" />
                        <shiny:RadioCell Title="Español" Value="es" />
                    </shiny:TableSection>

                    <shiny:TableSection x:Name="ThemeSection" Title="{l:Tr Settings_Theme}" shiny:RadioCell.SelectedValue="{Binding Theme, Mode=TwoWay}">
                        <shiny:RadioCell Title="{l:Tr Settings_ThemeSystem}" Value="System" />
                        <shiny:RadioCell Title="{l:Tr Settings_ThemeLight}" Value="Light" />
                        <shiny:RadioCell Title="{l:Tr Settings_ThemeDark}" Value="Dark" />
                    </shiny:TableSection>

                    <shiny:TableSection x:Name="FontSection" Title="{l:Tr Settings_FontSize}" shiny:RadioCell.SelectedValue="{Binding ViewerFontSize, Mode=TwoWay}">
                        <shiny:RadioCell Title="{l:Tr Settings_FontSmall}" Value="12" />
                        <shiny:RadioCell Title="{l:Tr Settings_FontMedium}" Value="13" />
                        <shiny:RadioCell Title="{l:Tr Settings_FontLarge}" Value="15" />
                        <shiny:RadioCell Title="{l:Tr Settings_FontExtraLarge}" Value="18" />
                    </shiny:TableSection>

                    <shiny:TableSection x:Name="AboutSection" Title="{l:Tr Settings_About}">
                        <shiny:LabelCell Title="ShinyCommander" ValueText="{Binding AppVersion}" Description="{Binding UpdateStatus}" />
                        <shiny:ButtonCell x:Name="UpdateCell" Title="{Binding UpdateButtonText}" ButtonTextColor="{StaticResource Accent}" Command="{Binding UpdateCommand}" />
                        <shiny:LabelCell Title="{l:Tr Settings_Runtime}" Description="{Binding RuntimeInfo}" />
                        <shiny:LabelCell Title="{l:Tr Settings_BuiltWith}" Description="{l:Tr Settings_BuiltWithDesc}" />
                    </shiny:TableSection>
                </shiny:TableRoot>
            </shiny:TableView>
        </Grid>
    </Grid>
</ContentPage>
