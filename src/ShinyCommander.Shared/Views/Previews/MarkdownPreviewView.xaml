<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:md="http://shiny.net/maui/markdown"
             xmlns:views="clr-namespace:ShinyCommander.Views"
             x:Class="ShinyCommander.Views.MarkdownPreviewView"
             x:Name="Root">
    <md:MarkdownView Theme="{AppThemeBinding Light={StaticResource MarkdownLight}, Dark={StaticResource MarkdownDark}}"
                     Markdown="{Binding Markdown, Source={x:Reference Root}, x:DataType=views:MarkdownPreviewView, Converter={StaticResource MarkdownHeadings}}"
                     Padding="14" />
</ContentView>
