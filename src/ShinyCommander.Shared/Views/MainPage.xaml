<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:vm="clr-namespace:ShinyCommander.ViewModels"
             xmlns:views="clr-namespace:ShinyCommander.Views"
             xmlns:conv="clr-namespace:ShinyCommander.Converters"
             xmlns:l="clr-namespace:ShinyCommander"
             x:Class="ShinyCommander.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="ShinyCommander">

    <!-- The whole Total Commander keymap. Shiny's engine routes these on Windows (WinUI), macOS (NSEvent
         monitor) and Linux (GTK capture controller). CanExecute == false hands the key back to the focused
         text box, which is how typing into the command line coexists with Space/Backspace/Home/End. -->
    <shiny:KeyboardShortcuts.Shortcuts>
        <shiny:KeyboardShortcut Gesture="Up" Command="{Binding CursorUpCommand}" Description="{l:Tr Key_CursorUp}" Category="{l:Tr Cat_Navigation}" TextInput="Always" AllowRepeat="True" />
        <shiny:KeyboardShortcut Gesture="Down" Command="{Binding CursorDownCommand}" Description="{l:Tr Key_CursorDown}" Category="{l:Tr Cat_Navigation}" TextInput="Always" AllowRepeat="True" />
        <shiny:KeyboardShortcut Gesture="PageUp" Command="{Binding PageUpCommand}" Description="{l:Tr Key_PageUp}" Category="{l:Tr Cat_Navigation}" TextInput="Always" AllowRepeat="True" />
        <shiny:KeyboardShortcut Gesture="PageDown" Command="{Binding PageDownCommand}" Description="{l:Tr Key_PageDown}" Category="{l:Tr Cat_Navigation}" TextInput="Always" AllowRepeat="True" />
        <shiny:KeyboardShortcut Gesture="Home" Command="{Binding HomeCommand}" Description="{l:Tr Key_Home}" Category="{l:Tr Cat_Navigation}" TextInput="Always" />
        <shiny:KeyboardShortcut Gesture="End" Command="{Binding EndCommand}" Description="{l:Tr Key_End}" Category="{l:Tr Cat_Navigation}" TextInput="Always" />
        <shiny:KeyboardShortcut Gesture="Enter" Command="{Binding EnterCommand}" Description="{l:Tr Key_Enter}" Category="{l:Tr Cat_Navigation}" TextInput="Always" />
        <shiny:KeyboardShortcut Gesture="Backspace" Command="{Binding BackspaceCommand}" Description="{l:Tr Key_ParentFolder}" Category="{l:Tr Cat_Navigation}" TextInput="Always" AllowRepeat="True" />
        <shiny:KeyboardShortcut Gesture="Tab" Command="{Binding SwitchPanelCommand}" Description="{l:Tr Key_SwitchPanel}" Category="{l:Tr Cat_Navigation}" TextInput="Always" />
        <shiny:KeyboardShortcut Gesture="Escape" Command="{Binding EscapeCommand}" Description="{l:Tr Key_Escape}" Category="{l:Tr Cat_Navigation}" />
        <shiny:KeyboardShortcut Gesture="Primary+PageUp" Command="{Binding GoParentCommand}" Description="{l:Tr Key_ParentFolder}" Category="{l:Tr Cat_Navigation}" />
        <shiny:KeyboardShortcut Gesture="Primary+Backslash" Command="{Binding GoRootCommand}" Description="{l:Tr Key_RootFolder}" Category="{l:Tr Cat_Navigation}" />
        <shiny:KeyboardShortcut Gesture="Primary+Shift+H" Command="{Binding GoHomeCommand}" Description="{l:Tr Key_HomeFolder}" Category="{l:Tr Cat_Navigation}" />
        <shiny:KeyboardShortcut Gesture="Alt+Left" Command="{Binding GoBackCommand}" Description="{l:Tr Key_Back}" Category="{l:Tr Cat_Navigation}" />
        <shiny:KeyboardShortcut Gesture="Alt+Right" Command="{Binding GoForwardCommand}" Description="{l:Tr Key_Forward}" Category="{l:Tr Cat_Navigation}" />
        <shiny:KeyboardShortcut Gesture="Primary+Left" Command="{Binding OpenInOtherPanelCommand}" Description="{l:Tr Key_OpenInOtherPanel}" Category="{l:Tr Cat_Navigation}" />
        <shiny:KeyboardShortcut Gesture="Primary+Right" Command="{Binding OpenInOtherPanelCommand}" Description="{l:Tr Key_OpenInOtherPanel}" Category="{l:Tr Cat_Navigation}" />
        <shiny:KeyboardShortcut Gesture="Alt+F1" Command="{Binding DriveMenuLeftCommand}" Description="{l:Tr Key_DriveLeft}" Category="{l:Tr Cat_Navigation}" />
        <shiny:KeyboardShortcut Gesture="Alt+F2" Command="{Binding DriveMenuRightCommand}" Description="{l:Tr Key_DriveRight}" Category="{l:Tr Cat_Navigation}" />
        <shiny:KeyboardShortcut Gesture="Primary+D" Command="{Binding HotlistCommand}" Description="{l:Tr Key_Hotlist}" Category="{l:Tr Cat_Navigation}" />
        <shiny:KeyboardShortcut Gesture="Insert" Command="{Binding InsertCommand}" Description="{l:Tr Key_Insert}" Category="{l:Tr Cat_Selection}" TextInput="Always" AllowRepeat="True" />
        <shiny:KeyboardShortcut Gesture="Space" Command="{Binding SpaceCommand}" Description="{l:Tr Key_Space}" Category="{l:Tr Cat_Selection}" TextInput="Always" />
        <shiny:KeyboardShortcut Gesture="Shift+Up" Command="{Binding MarkUpCommand}" Description="{l:Tr Key_MarkUp}" Category="{l:Tr Cat_Selection}" TextInput="Always" AllowRepeat="True" />
        <shiny:KeyboardShortcut Gesture="Shift+Down" Command="{Binding MarkDownCommand}" Description="{l:Tr Key_MarkDown}" Category="{l:Tr Cat_Selection}" TextInput="Always" AllowRepeat="True" />
        <shiny:KeyboardShortcut Gesture="Primary+A" Command="{Binding SelectAllCommand}" Description="{l:Tr Key_SelectAll}" Category="{l:Tr Cat_Selection}" />
        <shiny:KeyboardShortcut Gesture="Primary+Shift+A" Command="{Binding DeselectAllCommand}" Description="{l:Tr Key_DeselectAll}" Category="{l:Tr Cat_Selection}" />
        <shiny:KeyboardShortcut Gesture="Primary+G" Command="{Binding SelectGroupCommand}" Description="{l:Tr Key_SelectGroup}" Category="{l:Tr Cat_Selection}" />
        <shiny:KeyboardShortcut Gesture="Primary+Shift+G" Command="{Binding DeselectGroupCommand}" Description="{l:Tr Key_DeselectGroup}" Category="{l:Tr Cat_Selection}" />
        <shiny:KeyboardShortcut Gesture="Primary+I" Command="{Binding InvertSelectionCommand}" Description="{l:Tr Key_InvertSelection}" Category="{l:Tr Cat_Selection}" />
        <shiny:KeyboardShortcut Gesture="Alt+Shift+E" Command="{Binding SelectSameExtensionCommand}" Description="{l:Tr Key_SameExtension}" Category="{l:Tr Cat_Selection}" />
        <shiny:KeyboardShortcut Gesture="F2" Command="{Binding RenameCommand}" Description="{l:Tr Key_Rename}" Category="{l:Tr Cat_Files}" />
        <shiny:KeyboardShortcut Gesture="Shift+F6" Command="{Binding RenameCommand}" Description="{l:Tr Key_Rename}" Category="{l:Tr Cat_Files}" />
        <shiny:KeyboardShortcut Gesture="F3" Command="{Binding ViewCommand}" Description="{l:Tr Key_View}" Category="{l:Tr Cat_Files}" />
        <shiny:KeyboardShortcut Gesture="F4" Command="{Binding EditCommand}" Description="{l:Tr Key_Edit}" Category="{l:Tr Cat_Files}" />
        <shiny:KeyboardShortcut Gesture="Shift+F4" Command="{Binding NewFileCommand}" Description="{l:Tr Key_NewFile}" Category="{l:Tr Cat_Files}" />
        <shiny:KeyboardShortcut Gesture="F5" Command="{Binding CopyCommand}" Description="{l:Tr Key_Copy}" Category="{l:Tr Cat_Files}" />
        <shiny:KeyboardShortcut Gesture="F6" Command="{Binding MoveCommand}" Description="{l:Tr Key_Move}" Category="{l:Tr Cat_Files}" />
        <shiny:KeyboardShortcut Gesture="F7" Command="{Binding MakeDirectoryCommand}" Description="{l:Tr Key_NewFolder}" Category="{l:Tr Cat_Files}" />
        <shiny:KeyboardShortcut Gesture="F8" Command="{Binding DeleteCommand}" Description="{l:Tr Key_Delete}" Category="{l:Tr Cat_Files}" />
        <shiny:KeyboardShortcut Gesture="Delete" Command="{Binding DeleteCommand}" Description="{l:Tr Key_Delete}" Category="{l:Tr Cat_Files}" />
        <shiny:KeyboardShortcut Gesture="Shift+F8" Command="{Binding DeletePermanentlyCommand}" Description="{l:Tr Key_DeletePermanently}" Category="{l:Tr Cat_Files}" />
        <shiny:KeyboardShortcut Gesture="Shift+Delete" Command="{Binding DeletePermanentlyCommand}" Description="{l:Tr Key_DeletePermanently}" Category="{l:Tr Cat_Files}" />
        <shiny:KeyboardShortcut Gesture="Primary+Backspace" Command="{Binding DeleteKeyCommand}" Description="{l:Tr Key_DeleteFinder}" Category="{l:Tr Cat_Files}" TextInput="Always" />
        <shiny:KeyboardShortcut Gesture="Primary+Alt+Backspace" Command="{Binding DeletePermanentlyKeyCommand}" Description="{l:Tr Key_DeletePermanently}" Category="{l:Tr Cat_Files}" TextInput="Always" />
        <shiny:KeyboardShortcut Gesture="Alt+F5" Command="{Binding PackCommand}" Description="{l:Tr Key_Pack}" Category="{l:Tr Cat_Files}" />
        <shiny:KeyboardShortcut Gesture="Alt+F9" Command="{Binding UnpackCommand}" Description="{l:Tr Key_Unpack}" Category="{l:Tr Cat_Files}" />
        <shiny:KeyboardShortcut Gesture="Primary+Shift+C" Command="{Binding CopyPathsToClipboardCommand}" Description="{l:Tr Key_CopyPaths}" Category="{l:Tr Cat_Files}" />
        <shiny:KeyboardShortcut Gesture="Primary+Enter" Command="{Binding CopyNameToCommandLineCommand}" Description="{l:Tr Key_NameToCommandLine}" Category="{l:Tr Cat_Files}" />
        <shiny:KeyboardShortcut Gesture="Primary+Shift+Enter" Command="{Binding CopyPathToCommandLineCommand}" Description="{l:Tr Key_PathToCommandLine}" Category="{l:Tr Cat_Files}" />
        <shiny:KeyboardShortcut Gesture="Primary+R" Command="{Binding RefreshCommand}" Description="{l:Tr Key_Refresh}" Category="{l:Tr Cat_View}" />
        <shiny:KeyboardShortcut Gesture="Primary+H" Command="{Binding ToggleHiddenCommand}" Description="{l:Tr Key_ToggleHidden}" Category="{l:Tr Cat_View}" />
        <shiny:KeyboardShortcut Gesture="Primary+B" Command="{Binding BranchViewCommand}" Description="{l:Tr Key_BranchView}" Category="{l:Tr Cat_View}" />
        <shiny:KeyboardShortcut Gesture="Primary+F8" Command="{Binding ToggleTreeCommand}" Description="{l:Tr Key_ToggleTree}" Category="{l:Tr Cat_View}" />
        <shiny:KeyboardShortcut Gesture="Primary+Shift+F1" Command="{Binding ThumbnailViewCommand}" Description="{l:Tr Key_Thumbnails}" Category="{l:Tr Cat_View}" />
        <shiny:KeyboardShortcut Gesture="Primary+F2" Command="{Binding DetailsViewCommand}" Description="{l:Tr Key_Details}" Category="{l:Tr Cat_View}" />
        <shiny:KeyboardShortcut Gesture="Primary+Shift+K" Command="{Binding ChooseColumnsCommand}" Description="{l:Tr Key_Columns}" Category="{l:Tr Cat_View}" />
        <shiny:KeyboardShortcut Gesture="Ctrl+Q" Command="{Binding QuickViewCommand}" Description="{l:Tr Key_QuickView}" Category="{l:Tr Cat_View}" />
        <shiny:KeyboardShortcut Gesture="Primary+J" Command="{Binding ToggleJobsCommand}" Description="{l:Tr Key_Jobs}" Category="{l:Tr Cat_View}" />
        <shiny:KeyboardShortcut Gesture="Primary+Shift+L" Command="{Binding TogglePanelLayoutCommand}" Description="{l:Tr Key_PanelLayout}" Category="{l:Tr Cat_View}" />
        <shiny:KeyboardShortcut Gesture="Left" Command="{Binding CursorLeftCommand}" Description="{l:Tr Key_TileLeft}" Category="{l:Tr Cat_Navigation}" TextInput="Always" AllowRepeat="True" />
        <shiny:KeyboardShortcut Gesture="Right" Command="{Binding CursorRightCommand}" Description="{l:Tr Key_TileRight}" Category="{l:Tr Cat_Navigation}" TextInput="Always" AllowRepeat="True" />
        <shiny:KeyboardShortcut Gesture="Primary+F" Command="{Binding QuickFilterCommand}" Description="{l:Tr Key_QuickFilter}" Category="{l:Tr Cat_View}" />
        <shiny:KeyboardShortcut Gesture="Primary+T" Command="{Binding NewTabCommand}" Description="{l:Tr Key_NewTab}" Category="{l:Tr Cat_View}" />
        <shiny:KeyboardShortcut Gesture="Primary+W" Command="{Binding CloseTabCommand}" Description="{l:Tr Key_CloseTab}" Category="{l:Tr Cat_View}" />
        <shiny:KeyboardShortcut Gesture="Ctrl+Tab" Command="{Binding NextTabCommand}" Description="{l:Tr Key_NextTab}" Category="{l:Tr Cat_View}" TextInput="Always" />
        <shiny:KeyboardShortcut Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousTabCommand}" Description="{l:Tr Key_PreviousTab}" Category="{l:Tr Cat_View}" TextInput="Always" />
        <shiny:KeyboardShortcut Gesture="Primary+U" Command="{Binding SwapPanelsCommand}" Description="{l:Tr Key_SwapPanels}" Category="{l:Tr Cat_View}" />
        <shiny:KeyboardShortcut Gesture="Primary+Period" Command="{Binding TargetEqualsSourceCommand}" Description="{l:Tr Key_TargetEqualsSource}" Category="{l:Tr Cat_View}" />
        <shiny:KeyboardShortcut Gesture="Alt+F7" Command="{Binding FindCommand}" Description="{l:Tr Key_Find}" Category="{l:Tr Cat_Tools}" />
        <shiny:KeyboardShortcut Gesture="Primary+M" Command="{Binding MultiRenameCommand}" Description="{l:Tr Key_MultiRename}" Category="{l:Tr Cat_Tools}" />
        <shiny:KeyboardShortcut Gesture="Primary+Shift+S" Command="{Binding SynchronizeCommand}" Description="{l:Tr Key_Synchronize}" Category="{l:Tr Cat_Tools}" />
        <shiny:KeyboardShortcut Gesture="Primary+Shift+F2" Command="{Binding CompareFilesCommand}" Description="{l:Tr Key_CompareFiles}" Category="{l:Tr Cat_Tools}" />
        <shiny:KeyboardShortcut Gesture="Primary+O" Command="{Binding OpenTerminalCommand}" Description="{l:Tr Key_Terminal}" Category="{l:Tr Cat_Tools}" />
        <shiny:KeyboardShortcut Gesture="Primary+E" Command="{Binding RevealInFileManagerCommand}" Description="{l:Tr Key_Reveal}" Category="{l:Tr Cat_Tools}" />
        <shiny:KeyboardShortcut Gesture="Primary+Comma" Command="{Binding SettingsCommand}" Description="{l:Tr Key_Settings}" Category="{l:Tr Cat_Tools}" />
        <shiny:KeyboardShortcut Gesture="F1" Command="{Binding HelpCommand}" Description="{l:Tr Key_Help}" Category="{l:Tr Cat_Tools}" />
    </shiny:KeyboardShortcuts.Shortcuts>

    <ContentPage.Resources>
        <conv:RibbonTabVisibleConverter x:Key="RibbonTabVisible" />
        <conv:RibbonTabBackgroundConverter x:Key="RibbonTabBackground" />
        <conv:RibbonTabTextConverter x:Key="RibbonTabText" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" Padding="0">

        <!-- RIBBON:BEGIN (generated by tools/ribbon.py - edit the table there) -->
        <shiny:Ribbon x:Name="MainRibbon"
                      Grid.Row="0"
                      ApplicationButtonText="ShinyCommander"
                      ApplicationButtonCommand="{Binding HelpCommand}"
                      AccentColor="{StaticResource Accent}"
                      AllowCollapse="True"
                      ShowTooltips="True">
            <shiny:Ribbon.QuickAccessItems>
                <shiny:RibbonButton Text="{l:Tr Cmd_Settings}" Size="Small" Command="{Binding SettingsCommand}" Tooltip="{l:Tr Cmd_Settings}">
                    <shiny:RibbonButton.IconTemplate><DataTemplate><shiny:MotionIconView Icon="settings" Trigger="Appear" WidthRequest="16" HeightRequest="16" /></DataTemplate></shiny:RibbonButton.IconTemplate>
                </shiny:RibbonButton>
                <shiny:RibbonButton Text="{l:Tr Ribbon_Help}" Size="Small" Command="{Binding HelpCommand}" Tooltip="{l:Tr Cmd_Help, Suffix=' (F1)'}">
                    <shiny:RibbonButton.IconTemplate><DataTemplate><shiny:MotionIconView Icon="help" Trigger="Appear" WidthRequest="16" HeightRequest="16" /></DataTemplate></shiny:RibbonButton.IconTemplate>
                </shiny:RibbonButton>
            </shiny:Ribbon.QuickAccessItems>
            <shiny:RibbonTab Title="{l:Tr Ribbon_Tab_files}" Key="files">
                <shiny:RibbonGroup Title="{l:Tr Ribbon_Group_Transfer}">
                    <shiny:RibbonButton Text="{l:Tr Cmd_Copy}" Size="Large" Command="{Binding CopyCommand}" Shortcut="F5" Tooltip="{l:Tr Cmd_Copy, Suffix=' (F5)'}">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="copy" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="30" HeightRequest="30" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="{l:Tr Cmd_Move}" Size="Large" Command="{Binding MoveCommand}" Shortcut="F6" Tooltip="{l:Tr Cmd_Move, Suffix=' (F6)'}">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="arrow-right" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="30" HeightRequest="30" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="{l:Tr Cmd_Delete}" Size="Large" Command="{Binding DeleteCommand}" Shortcut="F8" Tooltip="{l:Tr Cmd_Delete, Suffix=' (F8)'}">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="trash" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="30" HeightRequest="30" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="{l:Tr Cmd_ToggleJobs}" Size="Small" Command="{Binding ToggleJobsCommand}" Shortcut="Primary+J" Tooltip="{l:Tr Cmd_ToggleJobs, Suffix=' (Primary+J)'}">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="hourglass" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                </shiny:RibbonGroup>
                <shiny:RibbonGroup Title="{l:Tr Ribbon_Group_Create}">
                    <shiny:RibbonButton Text="{l:Tr Cmd_MakeDirectory}" Size="Small" Command="{Binding MakeDirectoryCommand}" Shortcut="F7" Tooltip="{l:Tr Cmd_MakeDirectory, Suffix=' (F7)'}">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="folder" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="{l:Tr Cmd_NewFile}" Size="Small" Command="{Binding NewFileCommand}" Shortcut="Shift+F4" Tooltip="{l:Tr Cmd_NewFile, Suffix=' (Shift+F4)'}">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="file" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="{l:Tr Cmd_Rename}" Size="Small" Command="{Binding RenameCommand}" Shortcut="F2" Tooltip="{l:Tr Cmd_Rename, Suffix=' (F2)'}">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="edit" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                </shiny:RibbonGroup>
                <shiny:RibbonGroup Title="{l:Tr Ribbon_Group_Open}">
                    <shiny:RibbonButton Text="{l:Tr Cmd_View}" Size="Large" Command="{Binding ViewCommand}" Shortcut="F3" Tooltip="{l:Tr Cmd_View, Suffix=' (F3)'}">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="eye" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="30" HeightRequest="30" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="{l:Tr Cmd_Edit}" Size="Small" Command="{Binding EditCommand}" Shortcut="F4" Tooltip="{l:Tr Cmd_Edit, Suffix=' (F4)'}">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="file-text" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="{l:Tr Cmd_OpenTerminal}" Size="Small" Command="{Binding OpenTerminalCommand}" Shortcut="Primary+O" Tooltip="{l:Tr Cmd_OpenTerminal, Suffix=' (Primary+O)'}">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="external-link" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="{l:Tr Cmd_RevealInFileManager}" Size="Small" Command="{Binding RevealInFileManagerCommand}" Shortcut="Primary+E" Tooltip="{l:Tr Cmd_RevealInFileManager, Suffix=' (Primary+E)'}">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="search" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                </shiny:RibbonGroup>
                <shiny:RibbonGroup Title="{l:Tr Ribbon_Group_Archive}">
                    <shiny:RibbonButton Text="{l:Tr Cmd_Pack}" Size="Small" Command="{Binding PackCommand}" Shortcut="Alt+F5" Tooltip="{l:Tr Cmd_Pack, Suffix=' (Alt+F5)'}">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="download" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="{l:Tr Cmd_Unpack}" Size="Small" Command="{Binding UnpackCommand}" Shortcut="Alt+F9" Tooltip="{l:Tr Cmd_Unpack, Suffix=' (Alt+F9)'}">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="upload" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                </shiny:RibbonGroup>
                <shiny:RibbonGroup Title="{l:Tr Ribbon_Group_Clipboard}">
                    <shiny:RibbonButton Text="{l:Tr Cmd_CopyPathsToClipboard}" Size="Small" Command="{Binding CopyPathsToClipboardCommand}" Shortcut="Primary+Shift+C" Tooltip="{l:Tr Cmd_CopyPathsToClipboard, Suffix=' (Primary+Shift+C)'}">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="clipboard" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="{l:Tr Cmd_CopyNameToCommandLine}" Size="Small" Command="{Binding CopyNameToCommandLineCommand}" Shortcut="Primary+Enter" Tooltip="{l:Tr Cmd_CopyNameToCommandLine, Suffix=' (Primary+Enter)'}">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="arrow-down" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                </shiny:RibbonGroup>
            </shiny:RibbonTab>
            <shiny:RibbonTab Title="{l:Tr Ribbon_Tab_select}" Key="select">
                <shiny:RibbonGroup Title="{l:Tr Ribbon_Group_Mark}">
                    <shiny:RibbonButton Text="{l:Tr Cmd_SelectAll}" Size="Large" Command="{Binding SelectAllCommand}" Shortcut="Primary+A" Tooltip="{l:Tr Cmd_SelectAll, Suffix=' (Primary+A)'}">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="check-circle" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="30" HeightRequest="30" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="{l:Tr Cmd_DeselectAll}" Size="Small" Command="{Binding DeselectAllCommand}" Shortcut="Primary+Shift+A" Tooltip="{l:Tr Cmd_DeselectAll, Suffix=' (Primary+Shift+A)'}">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="x-circle" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="{l:Tr Cmd_InvertSelection}" Size="Small" Command="{Binding InvertSelectionCommand}" Shortcut="Primary+I" Tooltip="{l:Tr Cmd_InvertSelection, Suffix=' (Primary+I)'}">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="shuffle" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                </shiny:RibbonGroup>
                <shiny:RibbonGroup Title="{l:Tr Ribbon_Group_ByPattern}">
                    <shiny:RibbonButton Text="{l:Tr Cmd_SelectGroup}" Size="Small" Command="{Binding SelectGroupCommand}" Shortcut="Primary+G" Tooltip="{l:Tr Cmd_SelectGroup, Suffix=' (Primary+G)'}">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="filter" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="{l:Tr Cmd_DeselectGroup}" Size="Small" Command="{Binding DeselectGroupCommand}" Shortcut="Primary+Shift+G" Tooltip="{l:Tr Cmd_DeselectGroup, Suffix=' (Primary+Shift+G)'}">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="close" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
