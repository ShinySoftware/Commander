                                <Border Style="{StaticResource RibbonSmall}" AutomationId="ribbon-CompareFiles" ToolTipProperties.Text="Compare Files (Primary+Shift+F2)">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding CompareFilesCommand}" /></Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <shiny:MotionIconView Icon="activity" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear,Hover,Press" StrokeWidth="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                        <Label Text="Compare Files" Style="{StaticResource RibbonText}" VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <Label Grid.Row="1" Text="Compare" Style="{StaticResource RibbonGroupTitle}" />
                        </Grid>
                        <BoxView Style="{StaticResource RibbonDivider}" />
                        <Grid RowDefinitions="*,Auto" Padding="4,0">
                            <HorizontalStackLayout Spacing="2">
                                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                <Border Style="{StaticResource RibbonSmall}" AutomationId="ribbon-Settings" ToolTipProperties.Text="Settings (Primary+,)">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SettingsCommand}" /></Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <shiny:MotionIconView Icon="settings" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear,Hover,Press" StrokeWidth="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                        <Label Text="Settings" Style="{StaticResource RibbonText}" VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border Style="{StaticResource RibbonSmall}" AutomationId="ribbon-Help" ToolTipProperties.Text="Keyboard Help (F1)">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding HelpCommand}" /></Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <shiny:MotionIconView Icon="help" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear,Hover,Press" StrokeWidth="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                        <Label Text="Keyboard Help" Style="{StaticResource RibbonText}" VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <Label Grid.Row="1" Text="App" Style="{StaticResource RibbonGroupTitle}" />
                        </Grid>
                    </HorizontalStackLayout>
                </Grid>
            </Border>
        </Grid>
        <!-- RIBBON:END -->

        <!-- the two panels - side by side or stacked (Primary+Shift+L); the page re-arranges this grid -->
        <Grid x:Name="PanelsGrid" Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="6" RowSpacing="6" Padding="6,6,6,4">
            <views:FilePanelView x:Name="LeftPanel" Grid.Column="0" BindingContext="{Binding Left}" />
            <views:FilePanelView x:Name="RightPanel" Grid.Column="1" BindingContext="{Binding Right}" />
        </Grid>

        <!-- console output of command-line commands -->
        <Border Grid.Row="2" IsVisible="{Binding ShowOutput}" Style="{StaticResource Card}" Margin="6,0,6,4" Padding="0">
            <Grid RowDefinitions="Auto,*" HeightRequest="190">
                <Grid ColumnDefinitions="*,Auto,Auto" Padding="8,2" Style="{StaticResource Toolbar}">
                    <HorizontalStackLayout Spacing="6">
                        <shiny:MotionIconView Icon="activity" Color="{StaticResource Accent}" IsPlaying="{Binding IsCommandRunning}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        <Label Text="Console" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                        <ActivityIndicator IsRunning="{Binding IsCommandRunning}" IsVisible="{Binding IsCommandRunning}" HeightRequest="14" WidthRequest="14" Color="{StaticResource Accent}" />
                    </HorizontalStackLayout>
                    <shiny:ShinyButton Grid.Column="1" Text="Stop" Command="{Binding CancelCommandCommand}" IsVisible="{Binding IsCommandRunning}" Appearance="Text" FontSize="12" ContentPadding="6,2" />
                    <shiny:ShinyButton Grid.Column="2" Text="✕" Command="{Binding CloseOutputCommand}" Appearance="Text" FontSize="12" ContentPadding="6,2" />
                </Grid>
                <ScrollView x:Name="OutputScroll" Grid.Row="1" Padding="8,4">
                    <Label x:Name="OutputLabel" Text="{Binding CommandOutput}" FontFamily="{DynamicResource MonoFont}" FontSize="12" />
                </ScrollView>
            </Grid>
        </Border>

        <!-- copy / move / delete progress (Esc cancels) -->
        <Border Grid.Row="3" IsVisible="{Binding IsOperationRunning}" Style="{StaticResource Card}" Margin="6,0,6,4" Padding="10,6">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="3">
                <shiny:MotionIconView Grid.RowSpan="3" Icon="hourglass" Color="{StaticResource Accent}" IsPlaying="{Binding IsOperationRunning}" WidthRequest="28" HeightRequest="28" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding OperationTitle}" FontAttributes="Bold" />
                <shiny:ProgressBar Grid.Column="1" Grid.Row="1" Value="{Binding OperationProgress}" Maximum="1" TrackHeight="8" UseGradient="True" PulseEnabled="True" />
                <Label Grid.Column="1" Grid.Row="2" Text="{Binding OperationDetail}" Style="{StaticResource Subtle}" LineBreakMode="MiddleTruncation" />
                <shiny:ShinyButton Grid.Column="2" Grid.RowSpan="3" Text="Cancel" Command="{Binding CancelOperationCommand}" Appearance="Tonal" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- command line -->
        <Grid Grid.Row="4" ColumnDefinitions="Auto,*" Padding="10,2,10,2" ColumnSpacing="6">
            <Label Text="{Binding CommandPrompt}" FontFamily="{DynamicResource MonoFont}" FontSize="12" VerticalOptions="Center" LineBreakMode="HeadTruncation" MaximumWidthRequest="520" Style="{StaticResource Subtle}" />
            <Entry x:Name="CommandEntry" AutomationId="CommandLine"
                   Grid.Column="1"
                   Text="{Binding CommandText}"
                   FontFamily="{DynamicResource MonoFont}"
                   FontSize="12"
                   Placeholder="type a command, or use the keys below…" />
        </Grid>

        <!-- function key bar -->
        <Grid Grid.Row="5" Padding="6,4" ColumnSpacing="6" ColumnDefinitions="*,*,*,*,*,*,*,*">
            <Border Grid.Column="0" Style="{StaticResource KeyCap}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding RenameCommand}" /></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                    <Border Style="{StaticResource KeyCapKey}"><Label Text="F2" Style="{StaticResource KeyCapKeyText}" /></Border>
                    <shiny:MotionIconView Icon="edit" Trigger="Hover,Press" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                    <Label Text="Rename" FontSize="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource KeyCap}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ViewCommand}" /></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                    <Border Style="{StaticResource KeyCapKey}"><Label Text="F3" Style="{StaticResource KeyCapKeyText}" /></Border>
                    <shiny:MotionIconView Icon="eye" Trigger="Hover,Press" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                    <Label Text="View" FontSize="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource KeyCap}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding EditCommand}" /></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                    <Border Style="{StaticResource KeyCapKey}"><Label Text="F4" Style="{StaticResource KeyCapKeyText}" /></Border>
                    <shiny:MotionIconView Icon="file-text" Trigger="Hover,Press" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                    <Label Text="Edit" FontSize="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource KeyCap}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding CopyCommand}" /></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                    <Border Style="{StaticResource KeyCapKey}"><Label Text="F5" Style="{StaticResource KeyCapKeyText}" /></Border>
                    <shiny:MotionIconView Icon="copy" Trigger="Hover,Press" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                    <Label Text="Copy" FontSize="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource KeyCap}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding MoveCommand}" /></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                    <Border Style="{StaticResource KeyCapKey}"><Label Text="F6" Style="{StaticResource KeyCapKeyText}" /></Border>
                    <shiny:MotionIconView Icon="arrow-right" Trigger="Hover,Press" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                    <Label Text="Move" FontSize="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="5" Style="{StaticResource KeyCap}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding MakeDirectoryCommand}" /></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                    <Border Style="{StaticResource KeyCapKey}"><Label Text="F7" Style="{StaticResource KeyCapKeyText}" /></Border>
                    <shiny:MotionIconView Icon="folder" Trigger="Hover,Press" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                    <Label Text="New Folder" FontSize="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource KeyCap}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding DeleteCommand}" /></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                    <Border Style="{StaticResource KeyCapKey}"><Label Text="F8" Style="{StaticResource KeyCapKeyText}" /></Border>
                    <shiny:MotionIconView Icon="trash" Trigger="Hover,Press" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                    <Label Text="Delete" FontSize="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="7" Style="{StaticResource KeyCap}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding FindCommand}" /></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                    <Border Style="{StaticResource KeyCapKey}"><Label Text="Alt+F7" Style="{StaticResource KeyCapKeyText}" /></Border>
                    <shiny:MotionIconView Icon="search" Trigger="Hover,Press" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                    <Label Text="Find" FontSize="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
