                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="0" IsVisible="{Binding RibbonTab, Converter={StaticResource RibbonTabVisible}, ConverterParameter=go}">
                        <Grid RowDefinitions="*,Auto" Padding="4,0">
                            <HorizontalStackLayout Spacing="2">
                            <Border Style="{StaticResource RibbonLarge}" AutomationId="ribbon-GoBack" ToolTipProperties.Text="{l:Tr Cmd_GoBack, Suffix=' (Alt+Left)'}">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoBackCommand}" /></Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="3">
                                    <shiny:MotionIconView Icon="arrow-left" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear,Hover,Press" StrokeWidth="2" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" />
                                    <Label Text="{l:Tr Cmd_GoBack}" Style="{StaticResource RibbonText}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                <Border Style="{StaticResource RibbonSmall}" AutomationId="ribbon-GoForward" ToolTipProperties.Text="{l:Tr Cmd_GoForward, Suffix=' (Alt+Right)'}">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoForwardCommand}" /></Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <shiny:MotionIconView Icon="arrow-right" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear,Hover,Press" StrokeWidth="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                        <Label Text="{l:Tr Cmd_GoForward}" Style="{StaticResource RibbonText}" VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border Style="{StaticResource RibbonSmall}" AutomationId="ribbon-GoParent" ToolTipProperties.Text="{l:Tr Cmd_GoParent, Suffix=' (Backspace)'}">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoParentCommand}" /></Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <shiny:MotionIconView Icon="arrow-up" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear,Hover,Press" StrokeWidth="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                        <Label Text="{l:Tr Cmd_GoParent}" Style="{StaticResource RibbonText}" VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <Label Grid.Row="1" Text="{l:Tr Ribbon_Group_History}" Style="{StaticResource RibbonGroupTitle}" />
                        </Grid>
                        <BoxView Style="{StaticResource RibbonDivider}" />
                        <Grid RowDefinitions="*,Auto" Padding="4,0">
                            <HorizontalStackLayout Spacing="2">
                            <Border Style="{StaticResource RibbonLarge}" AutomationId="ribbon-GoHome" ToolTipProperties.Text="{l:Tr Cmd_GoHome, Suffix=' (Primary+Shift+H)'}">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoHomeCommand}" /></Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="3">
                                    <shiny:MotionIconView Icon="home" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear,Hover,Press" StrokeWidth="2" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" />
                                    <Label Text="{l:Tr Cmd_GoHome}" Style="{StaticResource RibbonText}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                <Border Style="{StaticResource RibbonSmall}" AutomationId="ribbon-GoRoot" ToolTipProperties.Text="{l:Tr Cmd_GoRoot, Suffix=' (Primary+\\)'}">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoRootCommand}" /></Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <shiny:MotionIconView Icon="database" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear,Hover,Press" StrokeWidth="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                        <Label Text="{l:Tr Cmd_GoRoot}" Style="{StaticResource RibbonText}" VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border Style="{StaticResource RibbonSmall}" AutomationId="ribbon-Hotlist" ToolTipProperties.Text="{l:Tr Cmd_Hotlist, Suffix=' (Primary+D)'}">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding HotlistCommand}" /></Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <shiny:MotionIconView Icon="star" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear,Hover,Press" StrokeWidth="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                        <Label Text="{l:Tr Cmd_Hotlist}" Style="{StaticResource RibbonText}" VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <Label Grid.Row="1" Text="{l:Tr Ribbon_Group_Places}" Style="{StaticResource RibbonGroupTitle}" />
                        </Grid>
                        <BoxView Style="{StaticResource RibbonDivider}" />
                        <Grid RowDefinitions="*,Auto" Padding="4,0">
                            <HorizontalStackLayout Spacing="2">
                                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                <Border Style="{StaticResource RibbonSmall}" AutomationId="ribbon-DriveMenuLeft" ToolTipProperties.Text="{l:Tr Cmd_DriveMenuLeft, Suffix=' (Alt+F1)'}">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding DriveMenuLeftCommand}" /></Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <shiny:MotionIconView Icon="compass" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear,Hover,Press" StrokeWidth="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                        <Label Text="{l:Tr Cmd_DriveMenuLeft}" Style="{StaticResource RibbonText}" VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border Style="{StaticResource RibbonSmall}" AutomationId="ribbon-DriveMenuRight" ToolTipProperties.Text="{l:Tr Cmd_DriveMenuRight, Suffix=' (Alt+F2)'}">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding DriveMenuRightCommand}" /></Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <shiny:MotionIconView Icon="compass" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear,Hover,Press" StrokeWidth="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                        <Label Text="{l:Tr Cmd_DriveMenuRight}" Style="{StaticResource RibbonText}" VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border Style="{StaticResource RibbonSmall}" AutomationId="ribbon-OpenInOtherPanel" ToolTipProperties.Text="{l:Tr Cmd_OpenInOtherPanel, Suffix=' (Primary+Right)'}">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenInOtherPanelCommand}" /></Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <shiny:MotionIconView Icon="chevron-right" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear,Hover,Press" StrokeWidth="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                        <Label Text="{l:Tr Cmd_OpenInOtherPanel}" Style="{StaticResource RibbonText}" VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <Label Grid.Row="1" Text="{l:Tr Ribbon_Group_Drives}" Style="{StaticResource RibbonGroupTitle}" />
                        </Grid>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="0" IsVisible="{Binding RibbonTab, Converter={StaticResource RibbonTabVisible}, ConverterParameter=tools}">
                        <Grid RowDefinitions="*,Auto" Padding="4,0">
                            <HorizontalStackLayout Spacing="2">
                            <Border Style="{StaticResource RibbonLarge}" AutomationId="ribbon-Find" ToolTipProperties.Text="{l:Tr Cmd_Find, Suffix=' (Alt+F7)'}">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding FindCommand}" /></Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="3">
                                    <shiny:MotionIconView Icon="search" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear,Hover,Press" StrokeWidth="2" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" />
                                    <Label Text="{l:Tr Cmd_Find}" Style="{StaticResource RibbonText}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            </HorizontalStackLayout>
                            <Label Grid.Row="1" Text="{l:Tr Ribbon_Group_Find}" Style="{StaticResource RibbonGroupTitle}" />
                        </Grid>
                        <BoxView Style="{StaticResource RibbonDivider}" />
                        <Grid RowDefinitions="*,Auto" Padding="4,0">
                            <HorizontalStackLayout Spacing="2">
                            <Border Style="{StaticResource RibbonLarge}" AutomationId="ribbon-MultiRename" ToolTipProperties.Text="{l:Tr Cmd_MultiRename, Suffix=' (Primary+M)'}">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding MultiRenameCommand}" /></Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="3">
                                    <shiny:MotionIconView Icon="edit" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear,Hover,Press" StrokeWidth="2" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" />
                                    <Label Text="{l:Tr Cmd_MultiRename}" Style="{StaticResource RibbonText}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            </HorizontalStackLayout>
                            <Label Grid.Row="1" Text="{l:Tr Ribbon_Group_Batch}" Style="{StaticResource RibbonGroupTitle}" />
                        </Grid>
                        <BoxView Style="{StaticResource RibbonDivider}" />
                        <Grid RowDefinitions="*,Auto" Padding="4,0">
                            <HorizontalStackLayout Spacing="2">
                            <Border Style="{StaticResource RibbonLarge}" AutomationId="ribbon-Synchronize" ToolTipProperties.Text="{l:Tr Cmd_Synchronize, Suffix=' (Primary+Shift+S)'}">
                                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SynchronizeCommand}" /></Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="3">
                                    <shiny:MotionIconView Icon="refresh" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear,Hover,Press" StrokeWidth="2" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" />
                                    <Label Text="{l:Tr Cmd_Synchronize}" Style="{StaticResource RibbonText}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                <Border Style="{StaticResource RibbonSmall}" AutomationId="ribbon-CompareFiles" ToolTipProperties.Text="{l:Tr Cmd_CompareFiles, Suffix=' (Primary+Shift+F2)'}">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding CompareFilesCommand}" /></Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <shiny:MotionIconView Icon="activity" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear,Hover,Press" StrokeWidth="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                        <Label Text="{l:Tr Cmd_CompareFiles}" Style="{StaticResource RibbonText}" VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <Label Grid.Row="1" Text="{l:Tr Ribbon_Group_Compare}" Style="{StaticResource RibbonGroupTitle}" />
                        </Grid>
                        <BoxView Style="{StaticResource RibbonDivider}" />
                        <Grid RowDefinitions="*,Auto" Padding="4,0">
                            <HorizontalStackLayout Spacing="2">
                                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                <Border Style="{StaticResource RibbonSmall}" AutomationId="ribbon-Settings" ToolTipProperties.Text="{l:Tr Cmd_Settings, Suffix=' (Primary+,)'}">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SettingsCommand}" /></Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <shiny:MotionIconView Icon="settings" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear,Hover,Press" StrokeWidth="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                        <Label Text="{l:Tr Cmd_Settings}" Style="{StaticResource RibbonText}" VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border Style="{StaticResource RibbonSmall}" AutomationId="ribbon-Help" ToolTipProperties.Text="{l:Tr Cmd_Help, Suffix=' (F1)'}">
                                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding HelpCommand}" /></Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <shiny:MotionIconView Icon="help" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear,Hover,Press" StrokeWidth="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                        <Label Text="{l:Tr Cmd_Help}" Style="{StaticResource RibbonText}" VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <Label Grid.Row="1" Text="{l:Tr Ribbon_Group_App}" Style="{StaticResource RibbonGroupTitle}" />
                        </Grid>
                    </HorizontalStackLayout>
                </Grid>
            </Border>
        </Grid>
        <!-- RIBBON:END -->

        <!-- the two panels - side by side or stacked (Primary+Shift+L); the page re-arranges this grid -->
        <Grid x:Name="PanelsGrid" Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="6" RowSpacing="6" Padding="6,6,6,4">
            <views:FilePanelView x:Name="LeftPanel" Grid.Column="0" BindingContext="{Binding Left}" />
            <views:FilePanelView x:Name="RightPanel" Grid.Column="1" BindingContext="{Binding Right}" />
        </Grid>

        <!-- console output of command-line commands -->
        <Border Grid.Row="2" IsVisible="{Binding ShowOutput}" Style="{StaticResource Card}" Margin="6,0,6,4" Padding="0">
            <Grid RowDefinitions="Auto,*" HeightRequest="190">
                <Grid ColumnDefinitions="*,Auto,Auto" Padding="8,2" Style="{StaticResource Toolbar}">
                    <HorizontalStackLayout Spacing="6">
                        <shiny:MotionIconView Icon="activity" Color="{StaticResource Accent}" IsPlaying="{Binding IsCommandRunning}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        <Label Text="{l:Tr Main_Console}" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                        <ActivityIndicator IsRunning="{Binding IsCommandRunning}" IsVisible="{Binding IsCommandRunning}" HeightRequest="14" WidthRequest="14" Color="{StaticResource Accent}" />
                    </HorizontalStackLayout>
                    <shiny:ShinyButton Grid.Column="1" Text="{l:Tr Common_Stop}" Command="{Binding CancelCommandCommand}" IsVisible="{Binding IsCommandRunning}" Appearance="Text" FontSize="12" ContentPadding="6,2" />
                    <shiny:ShinyButton Grid.Column="2" Text="✕" Command="{Binding CloseOutputCommand}" Appearance="Text" FontSize="12" ContentPadding="6,2" />
                </Grid>
                <ScrollView x:Name="OutputScroll" Grid.Row="1" Padding="8,4">
                    <Label x:Name="OutputLabel" Text="{Binding CommandOutput}" FontFamily="{DynamicResource MonoFont}" FontSize="12" />
                </ScrollView>
            </Grid>
        </Border>

        <!-- background jobs: copy / move / delete / pack / unpack (Primary+J) -->
        <Border Grid.Row="3" IsVisible="{Binding ShowJobs}" Style="{StaticResource Card}" Margin="6,0,6,4" Padding="0" AutomationId="JobsPane">
            <Grid RowDefinitions="Auto,Auto">
                <Grid ColumnDefinitions="*,Auto,Auto" Padding="8,2" Style="{StaticResource Toolbar}">
                    <HorizontalStackLayout Spacing="6">
                        <shiny:MotionIconView Icon="hourglass" Color="{StaticResource Accent}" IsPlaying="{Binding Jobs.IsBusy}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        <Label Text="{l:Tr Jobs_Title}" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                        <Label Text="{Binding Jobs.Summary}" Style="{StaticResource Subtle}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <shiny:ShinyButton Grid.Column="1" Text="{l:Tr Jobs_ClearCompleted}" AutomationId="ClearCompletedJobs" Command="{Binding ClearCompletedJobsCommand}" IsVisible="{Binding Jobs.HasFinished}" Appearance="Text" FontSize="12" ContentPadding="6,2" />
                    <shiny:ShinyButton Grid.Column="2" Text="✕" Command="{Binding ToggleJobsCommand}" Appearance="Text" FontSize="12" ContentPadding="6,2" ToolTipProperties.Text="{l:Tr Jobs_Hide, Suffix=' (Esc)'}" />
                </Grid>
                <Label Grid.Row="1" Text="{l:Tr Jobs_Empty}" Style="{StaticResource Subtle}" Padding="10,8" IsVisible="{Binding Jobs.IsEmpty}" />
                <ScrollView Grid.Row="1" MaximumHeightRequest="200" IsVisible="{Binding Jobs.HasJobs}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Jobs.Jobs}" Padding="8,4" Spacing="2">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:JobViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="2" Padding="2,4">
                                    <shiny:MotionIconView Grid.RowSpan="3" Icon="{Binding Icon}" IsPlaying="{Binding IsRunning}" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Title}" FontAttributes="Bold" LineBreakMode="MiddleTruncation" />
                                    <shiny:ProgressBar Grid.Column="1" Grid.Row="1" Value="{Binding Progress}" Maximum="1" TrackHeight="6" UseGradient="True" PulseEnabled="True" IsVisible="{Binding IsRunning}" />
                                    <Label Grid.Column="1" Grid.Row="2" Text="{Binding Subtitle}" Style="{StaticResource Subtle}" LineBreakMode="MiddleTruncation" />
                                    <shiny:PillView Grid.Column="2" Grid.RowSpan="3" Text="{Binding StateLabel}" Type="{Binding StatePill}" FontSize="10" VerticalOptions="Center" />
                                    <HorizontalStackLayout Grid.Column="3" Grid.RowSpan="3" Spacing="2" VerticalOptions="Center">
                                        <shiny:ShinyButton Text="{l:Tr Common_Stop}" IsVisible="{Binding IsRunning}" Appearance="Tonal" FontSize="12" ContentPadding="8,2"
                                                           Command="{Binding StopJobCommand, Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, x:DataType=vm:MainViewModel}" CommandParameter="{Binding .}" />
                                        <shiny:ShinyButton Text="{l:Tr Jobs_GoTo}" IsVisible="{Binding CanGoTo}" Appearance="Tonal" FontSize="12" ContentPadding="8,2"
                                                           Command="{Binding GoToJobCommand, Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, x:DataType=vm:MainViewModel}" CommandParameter="{Binding .}" />
                                        <shiny:ShinyButton Text="{l:Tr Jobs_Errors}" IsVisible="{Binding IsProblem}" Appearance="Text" FontSize="12" ContentPadding="6,2"
                                                           Command="{Binding ShowJobErrorsCommand, Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, x:DataType=vm:MainViewModel}" CommandParameter="{Binding .}" />
                                        <shiny:ShinyButton Text="✕" IsVisible="{Binding IsFinished}" Appearance="Text" FontSize="12" ContentPadding="6,2" ToolTipProperties.Text="{l:Tr Jobs_Remove}"
                                                           Command="{Binding DismissJobCommand, Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, x:DataType=vm:MainViewModel}" CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>

        <!-- command line -->
        <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" Padding="10,2,10,2" ColumnSpacing="6">
            <Label Text="{Binding CommandPrompt}" FontFamily="{DynamicResource MonoFont}" FontSize="12" VerticalOptions="Center" LineBreakMode="HeadTruncation" MaximumWidthRequest="520" Style="{StaticResource Subtle}" />
            <Entry x:Name="CommandEntry" AutomationId="CommandLine"
                   Grid.Column="1"
                   Text="{Binding CommandText}"
                   FontFamily="{DynamicResource MonoFont}"
                   FontSize="12"
                   Placeholder="{l:Tr Main_CommandPlaceholder}" />
            <!-- jobs at a glance - opens the jobs pane -->
            <Border Grid.Column="2" Style="{StaticResource Chip}" IsVisible="{Binding Jobs.HasJobs}" AutomationId="JobsChip" ToolTipProperties.Text="{l:Tr Jobs_Chip, Suffix=' (Primary+J)'}" VerticalOptions="Center">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleJobsCommand}" /></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="5">
                    <ActivityIndicator IsRunning="{Binding Jobs.IsBusy}" IsVisible="{Binding Jobs.IsBusy}" HeightRequest="12" WidthRequest="12" Color="{StaticResource Accent}" VerticalOptions="Center" />
                    <Label Text="{Binding Jobs.Summary}" FontSize="12" VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- function key bar -->
        <Grid Grid.Row="5" Padding="6,4" ColumnSpacing="6" ColumnDefinitions="*,*,*,*,*,*,*,*">
            <Border Grid.Column="0" Style="{StaticResource KeyCap}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding RenameCommand}" /></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                    <Border Style="{StaticResource KeyCapKey}"><Label Text="F2" Style="{StaticResource KeyCapKeyText}" /></Border>
                    <shiny:MotionIconView Icon="edit" Trigger="Hover,Press" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                    <Label Text="{l:Tr Cmd_Rename}" FontSize="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource KeyCap}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ViewCommand}" /></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                    <Border Style="{StaticResource KeyCapKey}"><Label Text="F3" Style="{StaticResource KeyCapKeyText}" /></Border>
                    <shiny:MotionIconView Icon="eye" Trigger="Hover,Press" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                    <Label Text="{l:Tr Cmd_View}" FontSize="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource KeyCap}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding EditCommand}" /></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                    <Border Style="{StaticResource KeyCapKey}"><Label Text="F4" Style="{StaticResource KeyCapKeyText}" /></Border>
                    <shiny:MotionIconView Icon="file-text" Trigger="Hover,Press" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                    <Label Text="{l:Tr Cmd_Edit}" FontSize="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource KeyCap}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding CopyCommand}" /></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                    <Border Style="{StaticResource KeyCapKey}"><Label Text="F5" Style="{StaticResource KeyCapKeyText}" /></Border>
                    <shiny:MotionIconView Icon="copy" Trigger="Hover,Press" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                    <Label Text="{l:Tr Cmd_Copy}" FontSize="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource KeyCap}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding MoveCommand}" /></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                    <Border Style="{StaticResource KeyCapKey}"><Label Text="F6" Style="{StaticResource KeyCapKeyText}" /></Border>
                    <shiny:MotionIconView Icon="arrow-right" Trigger="Hover,Press" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                    <Label Text="{l:Tr Cmd_Move}" FontSize="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="5" Style="{StaticResource KeyCap}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding MakeDirectoryCommand}" /></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                    <Border Style="{StaticResource KeyCapKey}"><Label Text="F7" Style="{StaticResource KeyCapKeyText}" /></Border>
                    <shiny:MotionIconView Icon="folder" Trigger="Hover,Press" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                    <Label Text="{l:Tr FKey_NewFolder}" FontSize="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource KeyCap}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding DeleteCommand}" /></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                    <Border Style="{StaticResource KeyCapKey}"><Label Text="F8" Style="{StaticResource KeyCapKeyText}" /></Border>
                    <shiny:MotionIconView Icon="trash" Trigger="Hover,Press" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                    <Label Text="{l:Tr Cmd_Delete}" FontSize="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="7" Style="{StaticResource KeyCap}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding FindCommand}" /></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="7" HorizontalOptions="Center">
                    <Border Style="{StaticResource KeyCapKey}"><Label Text="Alt+F7" Style="{StaticResource KeyCapKeyText}" /></Border>
                    <shiny:MotionIconView Icon="search" Trigger="Hover,Press" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                    <Label Text="{l:Tr FKey_Find}" FontSize="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
