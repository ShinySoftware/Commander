<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:vm="clr-namespace:ShinyCommander.ViewModels"
             xmlns:views="clr-namespace:ShinyCommander.Views"
             xmlns:conv="clr-namespace:ShinyCommander.Converters"
             x:Class="ShinyCommander.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="ShinyCommander">

    <!-- The whole Total Commander keymap. Shiny's engine routes these on Windows (WinUI), macOS (NSEvent
         monitor) and Linux (GTK capture controller). CanExecute == false hands the key back to the focused
         text box, which is how typing into the command line coexists with Space/Backspace/Home/End. -->
    <shiny:KeyboardShortcuts.Shortcuts>
        <shiny:KeyboardShortcut Gesture="Up" Command="{Binding CursorUpCommand}" Description="Move cursor up" Category="Navigation" TextInput="Always" AllowRepeat="True" />
        <shiny:KeyboardShortcut Gesture="Down" Command="{Binding CursorDownCommand}" Description="Move cursor down" Category="Navigation" TextInput="Always" AllowRepeat="True" />
        <shiny:KeyboardShortcut Gesture="PageUp" Command="{Binding PageUpCommand}" Description="Page up" Category="Navigation" TextInput="Always" AllowRepeat="True" />
        <shiny:KeyboardShortcut Gesture="PageDown" Command="{Binding PageDownCommand}" Description="Page down" Category="Navigation" TextInput="Always" AllowRepeat="True" />
        <shiny:KeyboardShortcut Gesture="Home" Command="{Binding HomeCommand}" Description="First item" Category="Navigation" TextInput="Always" />
        <shiny:KeyboardShortcut Gesture="End" Command="{Binding EndCommand}" Description="Last item" Category="Navigation" TextInput="Always" />
        <shiny:KeyboardShortcut Gesture="Enter" Command="{Binding EnterCommand}" Description="Open folder / archive / file, or run the command line" Category="Navigation" TextInput="Always" />
        <shiny:KeyboardShortcut Gesture="Backspace" Command="{Binding BackspaceCommand}" Description="Parent folder" Category="Navigation" TextInput="Always" AllowRepeat="True" />
        <shiny:KeyboardShortcut Gesture="Tab" Command="{Binding SwitchPanelCommand}" Description="Switch active panel" Category="Navigation" TextInput="Always" />
        <shiny:KeyboardShortcut Gesture="Escape" Command="{Binding EscapeCommand}" Description="Clear command line / close filter / cancel" Category="Navigation" />
        <shiny:KeyboardShortcut Gesture="Primary+PageUp" Command="{Binding GoParentCommand}" Description="Parent folder" Category="Navigation" />
        <shiny:KeyboardShortcut Gesture="Primary+Backslash" Command="{Binding GoRootCommand}" Description="Root folder" Category="Navigation" />
        <shiny:KeyboardShortcut Gesture="Primary+Shift+H" Command="{Binding GoHomeCommand}" Description="Home folder" Category="Navigation" />
        <shiny:KeyboardShortcut Gesture="Alt+Left" Command="{Binding GoBackCommand}" Description="Back (history)" Category="Navigation" />
        <shiny:KeyboardShortcut Gesture="Alt+Right" Command="{Binding GoForwardCommand}" Description="Forward (history)" Category="Navigation" />
        <shiny:KeyboardShortcut Gesture="Primary+Left" Command="{Binding OpenInOtherPanelCommand}" Description="Open folder under cursor in other panel" Category="Navigation" />
        <shiny:KeyboardShortcut Gesture="Primary+Right" Command="{Binding OpenInOtherPanelCommand}" Description="Open folder under cursor in other panel" Category="Navigation" />
        <shiny:KeyboardShortcut Gesture="Alt+F1" Command="{Binding DriveMenuLeftCommand}" Description="Change drive - left panel" Category="Navigation" />
        <shiny:KeyboardShortcut Gesture="Alt+F2" Command="{Binding DriveMenuRightCommand}" Description="Change drive - right panel" Category="Navigation" />
        <shiny:KeyboardShortcut Gesture="Primary+D" Command="{Binding HotlistCommand}" Description="Directory hotlist" Category="Navigation" />
        <shiny:KeyboardShortcut Gesture="Insert" Command="{Binding InsertCommand}" Description="Mark / unmark and move down" Category="Selection" TextInput="Always" AllowRepeat="True" />
        <shiny:KeyboardShortcut Gesture="Space" Command="{Binding SpaceCommand}" Description="Mark / unmark (calculates folder size)" Category="Selection" TextInput="Always" />
        <shiny:KeyboardShortcut Gesture="Shift+Up" Command="{Binding MarkUpCommand}" Description="Mark and move up" Category="Selection" TextInput="Always" AllowRepeat="True" />
        <shiny:KeyboardShortcut Gesture="Shift+Down" Command="{Binding MarkDownCommand}" Description="Mark and move down" Category="Selection" TextInput="Always" AllowRepeat="True" />
        <shiny:KeyboardShortcut Gesture="Primary+A" Command="{Binding SelectAllCommand}" Description="Select all" Category="Selection" />
        <shiny:KeyboardShortcut Gesture="Primary+Shift+A" Command="{Binding DeselectAllCommand}" Description="Unselect all" Category="Selection" />
        <shiny:KeyboardShortcut Gesture="Primary+G" Command="{Binding SelectGroupCommand}" Description="Select group (mask)" Category="Selection" />
        <shiny:KeyboardShortcut Gesture="Primary+Shift+G" Command="{Binding DeselectGroupCommand}" Description="Unselect group (mask)" Category="Selection" />
        <shiny:KeyboardShortcut Gesture="Primary+I" Command="{Binding InvertSelectionCommand}" Description="Invert selection" Category="Selection" />
        <shiny:KeyboardShortcut Gesture="Alt+Shift+E" Command="{Binding SelectSameExtensionCommand}" Description="Select files with same extension" Category="Selection" />
        <shiny:KeyboardShortcut Gesture="F2" Command="{Binding RenameCommand}" Description="Rename" Category="Files" />
        <shiny:KeyboardShortcut Gesture="Shift+F6" Command="{Binding RenameCommand}" Description="Rename" Category="Files" />
        <shiny:KeyboardShortcut Gesture="F3" Command="{Binding ViewCommand}" Description="View (lister)" Category="Files" />
        <shiny:KeyboardShortcut Gesture="F4" Command="{Binding EditCommand}" Description="Edit" Category="Files" />
        <shiny:KeyboardShortcut Gesture="Shift+F4" Command="{Binding NewFileCommand}" Description="New file + edit" Category="Files" />
        <shiny:KeyboardShortcut Gesture="F5" Command="{Binding CopyCommand}" Description="Copy" Category="Files" />
        <shiny:KeyboardShortcut Gesture="F6" Command="{Binding MoveCommand}" Description="Move / rename" Category="Files" />
        <shiny:KeyboardShortcut Gesture="F7" Command="{Binding MakeDirectoryCommand}" Description="New folder" Category="Files" />
        <shiny:KeyboardShortcut Gesture="F8" Command="{Binding DeleteCommand}" Description="Delete (to trash)" Category="Files" />
        <shiny:KeyboardShortcut Gesture="Delete" Command="{Binding DeleteCommand}" Description="Delete (to trash)" Category="Files" />
        <shiny:KeyboardShortcut Gesture="Shift+F8" Command="{Binding DeletePermanentlyCommand}" Description="Delete permanently" Category="Files" />
        <shiny:KeyboardShortcut Gesture="Shift+Delete" Command="{Binding DeletePermanentlyCommand}" Description="Delete permanently" Category="Files" />
        <shiny:KeyboardShortcut Gesture="Alt+F5" Command="{Binding PackCommand}" Description="Pack (zip, tar, tar.gz, tar.bz2)" Category="Files" />
        <shiny:KeyboardShortcut Gesture="Alt+F9" Command="{Binding UnpackCommand}" Description="Unpack archives" Category="Files" />
        <shiny:KeyboardShortcut Gesture="Primary+Shift+C" Command="{Binding CopyPathsToClipboardCommand}" Description="Copy full paths to clipboard" Category="Files" />
        <shiny:KeyboardShortcut Gesture="Primary+Enter" Command="{Binding CopyNameToCommandLineCommand}" Description="Name to command line" Category="Files" />
        <shiny:KeyboardShortcut Gesture="Primary+Shift+Enter" Command="{Binding CopyPathToCommandLineCommand}" Description="Full path to command line" Category="Files" />
        <shiny:KeyboardShortcut Gesture="Primary+R" Command="{Binding RefreshCommand}" Description="Reread folder" Category="View" />
        <shiny:KeyboardShortcut Gesture="Primary+H" Command="{Binding ToggleHiddenCommand}" Description="Show / hide hidden files" Category="View" />
        <shiny:KeyboardShortcut Gesture="Primary+B" Command="{Binding BranchViewCommand}" Description="Branch view (all files in subfolders)" Category="View" />
        <shiny:KeyboardShortcut Gesture="Primary+F8" Command="{Binding ToggleTreeCommand}" Description="Folder tree (active panel)" Category="View" />
        <shiny:KeyboardShortcut Gesture="Primary+Shift+F1" Command="{Binding ThumbnailViewCommand}" Description="Thumbnail view on / off" Category="View" />
        <shiny:KeyboardShortcut Gesture="Primary+F2" Command="{Binding DetailsViewCommand}" Description="Details view" Category="View" />
        <shiny:KeyboardShortcut Gesture="Primary+Shift+K" Command="{Binding ChooseColumnsCommand}" Description="Choose columns" Category="View" />
        <shiny:KeyboardShortcut Gesture="Ctrl+Q" Command="{Binding QuickViewCommand}" Description="Quick view in the other panel" Category="View" />
        <shiny:KeyboardShortcut Gesture="Primary+Shift+L" Command="{Binding TogglePanelLayoutCommand}" Description="Panels side by side / stacked" Category="View" />
        <shiny:KeyboardShortcut Gesture="Left" Command="{Binding CursorLeftCommand}" Description="Previous tile (thumbnail view)" Category="Navigation" TextInput="Always" AllowRepeat="True" />
        <shiny:KeyboardShortcut Gesture="Right" Command="{Binding CursorRightCommand}" Description="Next tile (thumbnail view)" Category="Navigation" TextInput="Always" AllowRepeat="True" />
        <shiny:KeyboardShortcut Gesture="Primary+F" Command="{Binding QuickFilterCommand}" Description="Quick filter" Category="View" />
        <shiny:KeyboardShortcut Gesture="Primary+T" Command="{Binding NewTabCommand}" Description="New tab" Category="View" />
        <shiny:KeyboardShortcut Gesture="Primary+W" Command="{Binding CloseTabCommand}" Description="Close tab" Category="View" />
        <shiny:KeyboardShortcut Gesture="Ctrl+Tab" Command="{Binding NextTabCommand}" Description="Next tab" Category="View" TextInput="Always" />
        <shiny:KeyboardShortcut Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousTabCommand}" Description="Previous tab" Category="View" TextInput="Always" />
        <shiny:KeyboardShortcut Gesture="Primary+U" Command="{Binding SwapPanelsCommand}" Description="Swap panels" Category="View" />
        <shiny:KeyboardShortcut Gesture="Primary+Period" Command="{Binding TargetEqualsSourceCommand}" Description="Target = source" Category="View" />
        <shiny:KeyboardShortcut Gesture="Alt+F7" Command="{Binding FindCommand}" Description="Find files" Category="Tools" />
        <shiny:KeyboardShortcut Gesture="Primary+M" Command="{Binding MultiRenameCommand}" Description="Multi-rename tool" Category="Tools" />
        <shiny:KeyboardShortcut Gesture="Primary+Shift+S" Command="{Binding SynchronizeCommand}" Description="Synchronize directories" Category="Tools" />
        <shiny:KeyboardShortcut Gesture="Primary+Shift+F2" Command="{Binding CompareFilesCommand}" Description="Compare files by content" Category="Tools" />
        <shiny:KeyboardShortcut Gesture="Primary+O" Command="{Binding OpenTerminalCommand}" Description="Open terminal here" Category="Tools" />
        <shiny:KeyboardShortcut Gesture="Primary+E" Command="{Binding RevealInFileManagerCommand}" Description="Reveal in system file manager" Category="Tools" />
        <shiny:KeyboardShortcut Gesture="Primary+Comma" Command="{Binding SettingsCommand}" Description="Settings" Category="Tools" />
        <shiny:KeyboardShortcut Gesture="F1" Command="{Binding HelpCommand}" Description="Keyboard reference" Category="Tools" />
    </shiny:KeyboardShortcuts.Shortcuts>

    <ContentPage.Resources>
        <conv:RibbonTabVisibleConverter x:Key="RibbonTabVisible" />
        <conv:RibbonTabBackgroundConverter x:Key="RibbonTabBackground" />
        <conv:RibbonTabTextConverter x:Key="RibbonTabText" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" Padding="0">

        <!-- RIBBON:BEGIN (generated by tools/ribbon.py - edit the table there) -->
        <shiny:Ribbon x:Name="MainRibbon"
                      Grid.Row="0"
                      ApplicationButtonText="ShinyCommander"
                      ApplicationButtonCommand="{Binding HelpCommand}"
                      AccentColor="{StaticResource Accent}"
                      AllowCollapse="True"
                      ShowTooltips="True">
            <shiny:Ribbon.QuickAccessItems>
                <shiny:RibbonButton Text="Settings" Size="Small" Command="{Binding SettingsCommand}" Tooltip="Settings">
                    <shiny:RibbonButton.IconTemplate><DataTemplate><shiny:MotionIconView Icon="settings" Trigger="Appear" WidthRequest="16" HeightRequest="16" /></DataTemplate></shiny:RibbonButton.IconTemplate>
                </shiny:RibbonButton>
                <shiny:RibbonButton Text="Help" Size="Small" Command="{Binding HelpCommand}" Tooltip="Keyboard reference (F1)">
                    <shiny:RibbonButton.IconTemplate><DataTemplate><shiny:MotionIconView Icon="help" Trigger="Appear" WidthRequest="16" HeightRequest="16" /></DataTemplate></shiny:RibbonButton.IconTemplate>
                </shiny:RibbonButton>
            </shiny:Ribbon.QuickAccessItems>
            <shiny:RibbonTab Title="Files" Key="files">
                <shiny:RibbonGroup Title="Transfer">
                    <shiny:RibbonButton Text="Copy" Size="Large" Command="{Binding CopyCommand}" Shortcut="F5" Tooltip="Copy (F5)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="copy" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="30" HeightRequest="30" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="Move" Size="Large" Command="{Binding MoveCommand}" Shortcut="F6" Tooltip="Move (F6)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="arrow-right" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="30" HeightRequest="30" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="Delete" Size="Large" Command="{Binding DeleteCommand}" Shortcut="F8" Tooltip="Delete (F8)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="trash" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="30" HeightRequest="30" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                </shiny:RibbonGroup>
                <shiny:RibbonGroup Title="Create">
                    <shiny:RibbonButton Text="New Folder" Size="Small" Command="{Binding MakeDirectoryCommand}" Shortcut="F7" Tooltip="New Folder (F7)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="folder" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="New File" Size="Small" Command="{Binding NewFileCommand}" Shortcut="Shift+F4" Tooltip="New File (Shift+F4)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="file" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="Rename" Size="Small" Command="{Binding RenameCommand}" Shortcut="F2" Tooltip="Rename (F2)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="edit" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                </shiny:RibbonGroup>
                <shiny:RibbonGroup Title="Open">
                    <shiny:RibbonButton Text="View" Size="Large" Command="{Binding ViewCommand}" Shortcut="F3" Tooltip="View (F3)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="eye" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="30" HeightRequest="30" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="Edit" Size="Small" Command="{Binding EditCommand}" Shortcut="F4" Tooltip="Edit (F4)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="file-text" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="Terminal" Size="Small" Command="{Binding OpenTerminalCommand}" Shortcut="Primary+O" Tooltip="Terminal (Primary+O)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="external-link" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="Reveal" Size="Small" Command="{Binding RevealInFileManagerCommand}" Shortcut="Primary+E" Tooltip="Reveal (Primary+E)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="search" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                </shiny:RibbonGroup>
                <shiny:RibbonGroup Title="Archive">
                    <shiny:RibbonButton Text="Pack" Size="Small" Command="{Binding PackCommand}" Shortcut="Alt+F5" Tooltip="Pack (Alt+F5)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="download" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="Unpack" Size="Small" Command="{Binding UnpackCommand}" Shortcut="Alt+F9" Tooltip="Unpack (Alt+F9)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="upload" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                </shiny:RibbonGroup>
                <shiny:RibbonGroup Title="Clipboard">
                    <shiny:RibbonButton Text="Copy Paths" Size="Small" Command="{Binding CopyPathsToClipboardCommand}" Shortcut="Primary+Shift+C" Tooltip="Copy Paths (Primary+Shift+C)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="clipboard" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="Name to Cmd" Size="Small" Command="{Binding CopyNameToCommandLineCommand}" Shortcut="Primary+Enter" Tooltip="Name to Cmd (Primary+Enter)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="arrow-down" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                </shiny:RibbonGroup>
            </shiny:RibbonTab>
            <shiny:RibbonTab Title="Selection" Key="select">
                <shiny:RibbonGroup Title="Mark">
                    <shiny:RibbonButton Text="Select All" Size="Large" Command="{Binding SelectAllCommand}" Shortcut="Primary+A" Tooltip="Select All (Primary+A)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="check-circle" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="30" HeightRequest="30" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="Unselect All" Size="Small" Command="{Binding DeselectAllCommand}" Shortcut="Primary+Shift+A" Tooltip="Unselect All (Primary+Shift+A)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="x-circle" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="Invert" Size="Small" Command="{Binding InvertSelectionCommand}" Shortcut="Primary+I" Tooltip="Invert (Primary+I)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="shuffle" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                </shiny:RibbonGroup>
                <shiny:RibbonGroup Title="By pattern">
                    <shiny:RibbonButton Text="Select Group…" Size="Small" Command="{Binding SelectGroupCommand}" Shortcut="Primary+G" Tooltip="Select Group… (Primary+G)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="filter" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="Unselect Group…" Size="Small" Command="{Binding DeselectGroupCommand}" Shortcut="Primary+Shift+G" Tooltip="Unselect Group… (Primary+Shift+G)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="close" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="Same Extension" Size="Small" Command="{Binding SelectSameExtensionCommand}" Shortcut="Alt+Shift+E" Tooltip="Same Extension (Alt+Shift+E)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="tag" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                </shiny:RibbonGroup>
            </shiny:RibbonTab>
            <shiny:RibbonTab Title="View" Key="view">
                <shiny:RibbonGroup Title="Panel">
                    <shiny:RibbonButton Text="Reread" Size="Large" Command="{Binding RefreshCommand}" Shortcut="Primary+R" Tooltip="Reread (Primary+R)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="refresh" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="30" HeightRequest="30" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="Hidden Files" Size="Small" Command="{Binding ToggleHiddenCommand}" Shortcut="Primary+H" Tooltip="Hidden Files (Primary+H)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="eye" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="Branch View" Size="Small" Command="{Binding BranchViewCommand}" Shortcut="Primary+B" Tooltip="Branch View (Primary+B)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="expand" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="Quick Filter" Size="Small" Command="{Binding QuickFilterCommand}" Shortcut="Primary+F" Tooltip="Quick Filter (Primary+F)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="filter" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                </shiny:RibbonGroup>
                <shiny:RibbonGroup Title="Show">
                    <shiny:RibbonButton Text="Thumbnails" Size="Large" Command="{Binding ThumbnailViewCommand}" Shortcut="Primary+Shift+F1" Tooltip="Thumbnails (Primary+Shift+F1)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="image" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="30" HeightRequest="30" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="Details" Size="Small" Command="{Binding DetailsViewCommand}" Shortcut="Primary+F2" Tooltip="Details (Primary+F2)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="menu" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="Columns…" Size="Small" Command="{Binding ChooseColumnsCommand}" Shortcut="Primary+Shift+K" Tooltip="Columns… (Primary+Shift+K)">
                        <shiny:RibbonButton.IconTemplate>
                            <DataTemplate><shiny:MotionIconView Icon="sort" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" /></DataTemplate>
                        </shiny:RibbonButton.IconTemplate>
                    </shiny:RibbonButton>
                    <shiny:RibbonButton Text="Folder Tree" Size="Small" Command="{Binding ToggleTreeCommand}" Shortcut="Primary+F8" Tooltip="Folder Tree (Primary+F8)">
                        <shiny:RibbonButton.IconTemplate>
