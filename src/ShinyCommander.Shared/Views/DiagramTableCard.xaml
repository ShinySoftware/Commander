<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShinyCommander.ViewModels"
             x:Class="ShinyCommander.Views.DiagramTableCard"
             InputTransparent="True">
    <!-- with a template the diagram draws no node of its own, so this is the whole table; clicks go through to the
         diagram underneath (select, drag, connect) -->
    <Border x:Name="Frame" Style="{StaticResource Card}" Padding="0" InputTransparent="True">
    <VerticalStackLayout x:Name="Card" x:DataType="vm:DiagramTable" Padding="10,7" Spacing="2" InputTransparent="True">
        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="13" LineBreakMode="TailTruncation" />
        <BoxView Style="{StaticResource Hairline}" Margin="0,3" />
        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Columns}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:DiagramTableColumn">
                    <Grid ColumnDefinitions="24,*,Auto" HeightRequest="18">
                        <Label Text="{Binding Badge}" FontSize="9" FontAttributes="Bold" TextColor="{StaticResource Accent}" VerticalTextAlignment="Center" />
                        <Label Grid.Column="1" Text="{Binding Name}" FontSize="12" FontFamily="{DynamicResource MonoFont}" LineBreakMode="TailTruncation" VerticalTextAlignment="Center" />
                        <Label Grid.Column="2" Text="{Binding Type}" Style="{StaticResource Subtle}" FontSize="11" VerticalTextAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </VerticalStackLayout>
    </Border>
</ContentView>
