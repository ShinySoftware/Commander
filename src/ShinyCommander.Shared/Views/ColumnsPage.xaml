<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:vm="clr-namespace:ShinyCommander.ViewModels"
             xmlns:views="clr-namespace:ShinyCommander.Views"
             xmlns:conv="clr-namespace:ShinyCommander.Converters"
             xmlns:l="clr-namespace:ShinyCommander"
             x:Class="ShinyCommander.Views.ColumnsPage"
             x:DataType="vm:ColumnsViewModel">

    <ContentPage.Resources>
        <conv:BoolToThemeColorConverter x:Key="BoolColor" />
    </ContentPage.Resources>

    <shiny:KeyboardShortcuts.Shortcuts>
        <shiny:KeyboardShortcut Gesture="Escape" Command="{Binding CloseCommand}" Description="{l:Tr Common_Close}" />
    </shiny:KeyboardShortcuts.Shortcuts>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Grid Grid.Row="0" Style="{StaticResource Toolbar}" Padding="10,6" HeightRequest="44" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <shiny:ShinyButton AutomationId="PageBack" Text="{l:Tr Page_Back}" Command="{Binding CloseCommand}" Appearance="Text" FontSize="12" ContentPadding="6,2" />
            <Label Grid.Column="1" Text="{l:Tr Columns_Title}" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
            <shiny:ShinyButton Grid.Column="2" AutomationId="ColumnsReset" Text="{l:Tr CustomizeToolbar_ResetToDefault}" Command="{Binding ResetCommand}" Appearance="Text" FontSize="12" ContentPadding="6,2" />
        </Grid>

        <Label Grid.Row="1" Style="{StaticResource Subtle}" Padding="16,12,16,4" Text="{l:Tr Columns_Intro}" />

        <!-- a folder with a setup: its own columns, or every folder's -->
        <HorizontalStackLayout Grid.Row="2" Spacing="6" Padding="16,6,16,0" IsVisible="{Binding HasSetup}">
            <Border Style="{StaticResource Chip}" AutomationId="ColumnsThisFolder"
                    BackgroundColor="{Binding ForFolder, Converter={StaticResource BoolColor}, ConverterParameter='CursorInactive|Transparent'}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowThisFolderCommand}" /></Border.GestureRecognizers>
                <Label Text="{Binding ThisFolder}" FontSize="12" VerticalOptions="Center">
                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowThisFolderCommand}" /></Label.GestureRecognizers>
                </Label>
            </Border>
            <Border Style="{StaticResource Chip}" AutomationId="ColumnsAllFolders"
                    BackgroundColor="{Binding ForFolder, Converter={StaticResource BoolColor}, ConverterParameter='Transparent|CursorInactive'}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowAllFoldersCommand}" /></Border.GestureRecognizers>
                <Label Text="{l:Tr Columns_AllFolders}" FontSize="12" VerticalOptions="Center">
                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowAllFoldersCommand}" /></Label.GestureRecognizers>
                </Label>
            </Border>
        </HorizontalStackLayout>

        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12" Padding="12,8,12,12">
            <!-- shown, left to right -->
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <Label Text="{l:Tr Columns_Shown}" Style="{StaticResource SectionTitle}" FontSize="11" Padding="14,10,14,6" />
                    <Grid Grid.Row="1" ColumnDefinitions="24,*" Padding="14,0,8,0" HeightRequest="32" ColumnSpacing="6">
                        <shiny:MotionIconView Icon="file-text" Color="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{l:Tr Columns_NameFirst}" Style="{StaticResource Subtle}" VerticalOptions="Center" />
                    </Grid>
                    <CollectionView Grid.Row="2" ItemsSource="{Binding Shown}" SelectionMode="None" AutomationId="ColumnsShown">
                        <CollectionView.EmptyView>
                            <Label Text="{l:Tr Columns_Empty}" Style="{StaticResource Subtle}" Padding="14,8" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ColumnChoice">
                                <Grid ColumnDefinitions="24,*,Auto,Auto,Auto,Auto" Padding="14,0,8,0" HeightRequest="32" ColumnSpacing="4">
                                    <shiny:MotionIconView Icon="menu" Color="{StaticResource Accent}" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Title}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="2" Text="{Binding Group}" Style="{StaticResource Subtle}" FontSize="11" VerticalOptions="Center" LineBreakMode="TailTruncation" Margin="0,0,6,0" />
                                    <views:IconButton Grid.Column="3" Icon="arrow-up" TestId="{Binding Key, StringFormat='ColumnLeft_{0}'}" ToolTipProperties.Text="{l:Tr Columns_MoveLeft}"
                                                      Command="{Binding MoveLeftCommand, Source={RelativeSource AncestorType={x:Type vm:ColumnsViewModel}}, x:DataType=vm:ColumnsViewModel}" CommandParameter="{Binding .}" />
                                    <views:IconButton Grid.Column="4" Icon="arrow-down" TestId="{Binding Key, StringFormat='ColumnRight_{0}'}" ToolTipProperties.Text="{l:Tr Columns_MoveRight}"
                                                      Command="{Binding MoveRightCommand, Source={RelativeSource AncestorType={x:Type vm:ColumnsViewModel}}, x:DataType=vm:ColumnsViewModel}" CommandParameter="{Binding .}" />
                                    <views:IconButton Grid.Column="5" Icon="close" TestId="{Binding Key, StringFormat='ColumnRemove_{0}'}" ToolTipProperties.Text="{l:Tr Common_Remove}"
                                                      Command="{Binding RemoveCommand, Source={RelativeSource AncestorType={x:Type vm:ColumnsViewModel}}, x:DataType=vm:ColumnsViewModel}" CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label Grid.Row="3" Text="{l:Tr Columns_AutoSets}" Style="{StaticResource Subtle}" FontSize="11" Padding="14,8,14,10" />
                </Grid>
            </Border>

            <!-- everything else: the built-in ones, then the custom ones and what they're for -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <Label Text="{l:Tr Columns_Available}" Style="{StaticResource SectionTitle}" FontSize="11" Padding="14,10,14,6" />
                    <CollectionView Grid.Row="1" ItemsSource="{Binding Available}" SelectionMode="None" AutomationId="ColumnsAvailable">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ColumnChoice">
                                <Grid ColumnDefinitions="*,Auto,Auto" Padding="14,0,8,0" HeightRequest="32" ColumnSpacing="6">
                                    <Label Text="{Binding Title}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1" Text="{Binding Group}" Style="{StaticResource Subtle}" FontSize="11" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                    <shiny:MotionIconView Grid.Column="2" Icon="plus" Color="{StaticResource Accent}" WidthRequest="13" HeightRequest="13" VerticalOptions="Center" Margin="6,0" />
                                    <!-- the click target: a clear Label over the row (see IconButton) -->
                                    <Label Grid.ColumnSpan="3" Text=" " Margin="-14,0,-8,0" AutomationId="{Binding Key, StringFormat='ColumnAdd_{0}'}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding AddCommand, Source={RelativeSource AncestorType={x:Type vm:ColumnsViewModel}}, x:DataType=vm:ColumnsViewModel}" CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
