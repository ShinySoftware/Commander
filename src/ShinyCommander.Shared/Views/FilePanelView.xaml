<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:md="http://shiny.net/maui/markdown"
             xmlns:vm="clr-namespace:ShinyCommander.ViewModels"
             xmlns:views="clr-namespace:ShinyCommander.Views"
             xmlns:conv="clr-namespace:ShinyCommander.Converters"
             xmlns:core="clr-namespace:ShinyCommander.Core.Models;assembly=ShinyCommander.Core"
             x:Class="ShinyCommander.Views.FilePanelView"
             x:DataType="vm:PanelViewModel">

    <ContentView.Resources>
        <!-- row visuals keyed off FileItemViewModel.RowState (cursor x marked) -->
        <conv:RowBackgroundConverter x:Key="RowBackground" />
        <conv:RowTextConverter x:Key="RowText" />
        <conv:RowFontConverter x:Key="RowFont" />
        <conv:BoolToThemeColorConverter x:Key="BoolColor" />
        <conv:DriveIconConverter x:Key="DriveIcon" />

        <Style x:Key="RowLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>

        <Style x:Key="RowSubLabel" TargetType="Label" BasedOn="{StaticResource RowLabel}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        </Style>

        <Style x:Key="HeaderLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}" />
        </Style>
    </ContentView.Resources>

    <Border x:Name="PanelBorder"
            Style="{StaticResource Card}"
            StrokeThickness="2"
            Stroke="{Binding IsActive, Converter={StaticResource BoolColor}, ConverterParameter='Accent|Border'}"
            Padding="0">

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

            <!-- folder tabs (Ctrl+T / Ctrl+W / Ctrl+Tab) -->
            <CollectionView Grid.Row="0"
                            ItemsSource="{Binding Tabs}"
                            IsVisible="{Binding HasMultipleTabs}"
                            SelectionMode="None"
                            HeightRequest="32"
                            ItemsLayout="HorizontalList">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PanelTabViewModel">
                        <Grid Padding="4,4,0,0">
                            <shiny:BadgeView Text="{Binding MarkedBadge}" Position="TopRight" FontSize="9" OffsetX="-2" OffsetY="2">
                                <Border Padding="10,3"
                                        StrokeShape="RoundRectangle 6,6,0,0"
                                        StrokeThickness="0"
                                        BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolColor}, ConverterParameter='Accent|Header'}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTabTapped" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Title}" FontSize="12" MaxLines="1" TextColor="{Binding IsSelected, Converter={StaticResource BoolColor}, ConverterParameter='White|Text'}" />
                                </Border>
                            </shiny:BadgeView>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- drive bar + free space -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="6,6,6,2" ColumnSpacing="8">
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="DriveBar" Spacing="4" BindableLayout.ItemsSource="{Binding Drives}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="core:DriveEntry">
                                <Border Style="{StaticResource Chip}">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDriveTapped" /></Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="4">
                                        <shiny:MotionIconView Icon="{Binding Name, Converter={StaticResource DriveIcon}}" Trigger="Hover,Press" Color="{StaticResource Accent}" WidthRequest="13" HeightRequest="13" VerticalOptions="Center" />
                                        <Label Text="{Binding Name}" FontSize="11" VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                    <shiny:ProgressBar Value="{Binding DriveUsage}" Maximum="1" WidthRequest="60" TrackHeight="5" VerticalOptions="Center" />
                    <shiny:PillView Text="{Binding FreeSpaceText}" Type="Info" FontSize="10" />
                </HorizontalStackLayout>
            </Grid>

            <!-- path / back / forward / up -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" Padding="6,2" ColumnSpacing="2">
                <shiny:ShinyButton Command="{Binding GoBackCommand}" LeftMotionIcon="arrow-left" Appearance="Text" ContentPadding="6,0" IconSize="14" />
                <shiny:ShinyButton Grid.Column="1" Command="{Binding GoForwardCommand}" LeftMotionIcon="arrow-right" Appearance="Text" ContentPadding="6,0" IconSize="14" />
                <shiny:ShinyButton Grid.Column="2" Command="{Binding GoUpCommand}" LeftMotionIcon="arrow-up" Appearance="Text" ContentPadding="6,0" IconSize="14" />
                <Entry x:Name="PathEntry"
                       Grid.Column="3"
                       Text="{Binding PathText}"
                       FontFamily="{DynamicResource MonoFont}"
                       FontSize="12"
                       Completed="OnPathCompleted"
                       Focused="OnPathFocused"
                       Unfocused="OnPathUnfocused" />
                <!-- what shows while not editing: head-truncated, so the folder you're in stays readable on deep paths.
                     A click switches to the entry underneath. -->
                <Border x:Name="PathLabelBox"
                        Grid.Column="3"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 5"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource PanelDark}}"
                        Padding="6,0"
                        Margin="0,4">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPathLabelTapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="PathLabel"
                           Text="{Binding PathText}"
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="12"
                           LineBreakMode="HeadTruncation"
                           MaxLines="1"
                           VerticalTextAlignment="Center" />
                </Border>
                <shiny:PillView Grid.Column="4" Text="{Binding ActiveTab.ArchiveBadge}" IsVisible="{Binding ActiveTab.IsArchive}" Type="Warning" FontSize="10" VerticalOptions="Center" Margin="4,0" />
                <shiny:ShinyButton Grid.Column="5" x:Name="ViewModeButton" Command="{Binding ToggleViewModeCommand}" LeftMotionIcon="image" Appearance="Text" ContentPadding="6,0" IconSize="15" ToolTipProperties.Text="Thumbnails / details" />
                <shiny:ShinyButton Grid.Column="6" x:Name="TreeButton" Command="{Binding ToggleTreeCommand}" LeftMotionIcon="folder-open" Appearance="Text" ContentPadding="6,0" IconSize="15" ToolTipProperties.Text="Folder tree" />
            </Grid>

            <!-- quick filter (Ctrl+F) -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Padding="8,0,8,4" ColumnSpacing="6" IsVisible="{Binding ShowQuickFilter}">
                <Label Text="Filter:" Style="{StaticResource Subtle}" VerticalOptions="Center" />
                <Entry x:Name="FilterEntry"
                       Grid.Column="1"
                       Placeholder="*.cs;*.md   (Esc closes)"
                       Text="{Binding ActiveTab.QuickFilter}"
                       Focused="OnFilterFocused"
                       Unfocused="OnFilterUnfocused" />
            </Grid>


            <!-- folder tree | files (details or thumbnails) or quick view -->
            <Grid Grid.Row="4" Grid.RowSpan="2" ColumnDefinitions="Auto,*">

                <!-- this panel's own folder tree (Primary+F8 / the folder button) -->
                <Grid x:Name="TreeColumn" Grid.Column="0" IsVisible="{Binding ShowTree}" WidthRequest="{Binding TreeWidth}" ColumnDefinitions="*,7">
                    <!-- a flat, virtualized list of the visible folders (FolderTreeViewModel) - stays quick with
                         hundreds of subfolders and deep paths -->
                    <CollectionView x:Name="FolderTree"
                                    ItemsSource="{Binding Tree.Rows}"
                                    SelectionMode="None"
                                    ItemSizingStrategy="MeasureFirstItem">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FolderRow">
                                <Grid ColumnDefinitions="14,Auto,*" ColumnSpacing="5" HeightRequest="22" Padding="{Binding Indent}"
                                      BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolColor}, ConverterParameter='CursorInactive|Transparent'}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTreeRowTapped" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="{Binding Chevron}" FontSize="11" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource SubtleLight}, Dark={StaticResource SubtleDark}}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnTreeChevronTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <shiny:MotionIconView Grid.Column="1" Icon="{Binding Icon}" Color="#F5A524" Trigger="Hover" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding Name}" FontSize="12" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <!-- drag to resize the tree against the file list -->
                    <Grid x:Name="TreeSplitter" Grid.Column="1" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnTreeSplitterPan" />
                        </Grid.GestureRecognizers>
                        <BoxView WidthRequest="1" HorizontalOptions="Center" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                        <BoxView WidthRequest="3" HeightRequest="28" CornerRadius="1.5" HorizontalOptions="Center" VerticalOptions="Center" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                    </Grid>
                </Grid>

                <Grid Grid.Column="1">
                    <!-- details: column headers (click to sort) + rows -->
                    <Grid RowDefinitions="Auto,*" IsVisible="{Binding ShowDetailsList}">
                        <Grid Grid.Row="0"
                              Padding="6,3"
                              BackgroundColor="{AppThemeBinding Light={StaticResource HeaderLight}, Dark={StaticResource HeaderDark}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{Binding Columns.ExtWidth}" />
                                <ColumnDefinition Width="{Binding Columns.SizeWidth}" />
                                <ColumnDefinition Width="{Binding Columns.ModifiedWidth}" />
                                <ColumnDefinition Width="{Binding Columns.CreatedWidth}" />
                                <ColumnDefinition Width="{Binding Columns.AttrWidth}" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="1" Text="{Binding ActiveTab.NameHeader}" Style="{StaticResource HeaderLabel}">
                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding SortCommand}" CommandParameter="Name" /></Label.GestureRecognizers>
                            </Label>
                            <Label Grid.Column="2" Text="{Binding ActiveTab.ExtHeader}" Style="{StaticResource HeaderLabel}" IsVisible="{Binding Columns.ShowExtension}">
                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding SortCommand}" CommandParameter="Extension" /></Label.GestureRecognizers>
                            </Label>
                            <Label Grid.Column="3" Text="{Binding ActiveTab.SizeHeader}" Style="{StaticResource HeaderLabel}" HorizontalTextAlignment="End" Margin="0,0,8,0" IsVisible="{Binding Columns.ShowSize}">
                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding SortCommand}" CommandParameter="Size" /></Label.GestureRecognizers>
                            </Label>
                            <Label Grid.Column="4" Text="{Binding ActiveTab.DateHeader}" Style="{StaticResource HeaderLabel}" IsVisible="{Binding Columns.ShowModified}">
                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding SortCommand}" CommandParameter="Modified" /></Label.GestureRecognizers>
                            </Label>
                            <Label Grid.Column="5" Text="{Binding ActiveTab.CreatedHeader}" Style="{StaticResource HeaderLabel}" IsVisible="{Binding Columns.ShowCreated}">
                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding SortCommand}" CommandParameter="Created" /></Label.GestureRecognizers>
                            </Label>
                            <Label Grid.Column="6" Text="{Binding ActiveTab.AttrHeader}" Style="{StaticResource HeaderLabel}" IsVisible="{Binding Columns.ShowAttributes}">
                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding SortCommand}" CommandParameter="Attributes" /></Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <!-- ItemsSource is set from code: only the list that's showing gets items (a hidden one would
                             realize every cell and keep them, slowing every page change) -->
                        <CollectionView x:Name="FileList" Grid.Row="1"
                                        SizeChanged="OnFileListSizeChanged"
                                        Scrolled="OnListScrolled"
                                        SelectionMode="None"
                                        ItemSizingStrategy="MeasureFirstItem">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileItemViewModel">
                                    <!-- icon + name are real views; the detail columns are drawn (FileDetailsView) - a light
                                         row is what keeps scrolling smooth on the AppKit head -->
                                    <Grid Padding="8,0" HeightRequest="24" ColumnDefinitions="24,*,Auto" BackgroundColor="{Binding RowState, Converter={StaticResource RowBackground}}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRowTapped" />
                                            <TapGestureRecognizer Tapped="OnRowDoubleTapped" NumberOfTapsRequired="2" />
                                            <TapGestureRecognizer Tapped="OnRowRightTapped" Buttons="Secondary" />
                                        </Grid.GestureRecognizers>

                                        <shiny:MotionIconView Icon="{Binding MotionIcon}"
                                                              Color="{Binding IconColor}"
                                                              IsPlaying="{Binding IsActiveCursor}"
                                                              Interval="0:0:2.5"
                                                              StrokeWidth="2"
                                                              WidthRequest="16"
                                                              HeightRequest="16"
                                                              HorizontalOptions="Start"
                                                              VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Name}" Style="{StaticResource RowLabel}" TextColor="{Binding RowState, Converter={StaticResource RowText}}" FontAttributes="{Binding RowState, Converter={StaticResource RowFont}}" />
                                        <views:FileDetailsView Grid.Column="2" Item="{Binding .}" HeightRequest="24" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>

                    <!-- thumbnails (Primary+Shift+F1): pictures for local images, big motion icons for the rest -->
                    <CollectionView x:Name="ThumbList"
                                    IsVisible="{Binding ShowThumbnailList}"
                                    SelectionMode="None"
                                    Margin="6"
                                    Scrolled="OnListScrolled"
                                    SizeChanged="OnThumbListSizeChanged">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout x:Name="ThumbLayout" Orientation="Vertical" Span="4" HorizontalItemSpacing="6" VerticalItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileItemViewModel">
                                <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="6" HeightRequest="136" MinimumHeightRequest="136"
                                        BackgroundColor="{Binding RowState, Converter={StaticResource RowBackground}}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRowTapped" />
                                        <TapGestureRecognizer Tapped="OnRowDoubleTapped" NumberOfTapsRequired="2" />
                                        <TapGestureRecognizer Tapped="OnRowRightTapped" Buttons="Secondary" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="90,30" RowSpacing="4">
                                        <Image Source="{Binding Thumbnail}" IsVisible="{Binding HasThumbnail}" Aspect="AspectFit" HeightRequest="90" />
                                        <shiny:MotionIconView Icon="{Binding MotionIcon}"
                                                              Color="{Binding IconColor}"
                                                              IsPlaying="{Binding IsActiveCursor}"
                                                              IsVisible="{Binding ShowIconTile}"
                                                              Interval="0:0:2.5"
                                                              StrokeWidth="1.5"
                                                              WidthRequest="54"
                                                              HeightRequest="54"
                                                              HorizontalOptions="Center"
                                                              VerticalOptions="Center" />
                                        <Label Grid.Row="1" Text="{Binding FullName}" FontSize="11" MaxLines="2" LineBreakMode="WordWrap" HorizontalTextAlignment="Center" VerticalTextAlignment="Start"
                                               TextColor="{Binding RowState, Converter={StaticResource RowText}}" FontAttributes="{Binding RowState, Converter={StaticResource RowFont}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- quick view (Ctrl+Q from the other panel) -->
                    <Grid IsVisible="{Binding IsQuickView}" RowDefinitions="Auto,*,Auto">
                        <Grid Padding="10,6" ColumnDefinitions="Auto,*" ColumnSpacing="8" BackgroundColor="{AppThemeBinding Light={StaticResource HeaderLight}, Dark={StaticResource HeaderDark}}">
                            <shiny:MotionIconView Icon="{Binding QuickView.MotionIcon}" Color="{Binding QuickView.IconColor}" Trigger="Appear" StrokeWidth="2" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding QuickView.Title}" FontAttributes="Bold" FontSize="13" VerticalTextAlignment="Center" LineBreakMode="MiddleTruncation" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ScrollView IsVisible="{Binding QuickView.IsText}" Orientation="Both">
                                <Label Text="{Binding QuickView.Text}" FontFamily="{DynamicResource MonoFont}" FontSize="12" Margin="10" />
                            </ScrollView>
                            <Image IsVisible="{Binding QuickView.IsImage}" Source="{Binding QuickView.Image}" Aspect="AspectFit" Margin="10" />
                            <md:MarkdownView IsVisible="{Binding QuickView.IsMarkdown}" Markdown="{Binding QuickView.Text}" Padding="14" />
                            <VerticalStackLayout IsVisible="{Binding QuickView.IsSummary}" Spacing="12" HorizontalOptions="Center" VerticalOptions="Center" Padding="20">
                                <shiny:MotionIconView Icon="{Binding QuickView.MotionIcon}" Color="{Binding QuickView.IconColor}" Trigger="Appear,Hover" StrokeWidth="1.5" WidthRequest="72" HeightRequest="72" HorizontalOptions="Center" />
                                <Label Text="{Binding QuickView.Info}" Style="{StaticResource Subtle}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <shiny:MotionIconView Icon="loader" IsPlaying="{Binding QuickView.IsLoading}" IsVisible="{Binding QuickView.IsLoading}" Color="{StaticResource Accent}" WidthRequest="32" HeightRequest="32" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                        <Label Grid.Row="2" Text="{Binding QuickView.Info}" IsVisible="{Binding QuickView.HasContent}" Style="{StaticResource Subtle}" FontSize="11" Padding="10,4" LineBreakMode="TailTruncation" />
                    </Grid>

                    <shiny:MotionIconView Icon="loader"
                                          IsPlaying="{Binding ActiveTab.IsLoading}"
                                          IsVisible="{Binding ActiveTab.IsLoading}"
                                          Color="{StaticResource Accent}"
                                          WidthRequest="36"
                                          HeightRequest="36"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center" />
                </Grid>
            </Grid>

            <!-- status: "x k / y k in a / b file(s), c / d dir(s)" -->
            <Grid Grid.Row="6"
                  ColumnDefinitions="*,Auto"
                  Padding="8,4"
                  BackgroundColor="{AppThemeBinding Light={StaticResource HeaderLight}, Dark={StaticResource HeaderDark}}">
                <Label Text="{Binding ActiveTab.StatusText}" Style="{StaticResource Subtle}" FontSize="11" LineBreakMode="TailTruncation" />
                <Label Grid.Column="1" Text="{Binding ActiveTab.Error}" TextColor="{StaticResource MarkedLight}" FontSize="11" LineBreakMode="TailTruncation" MaximumWidthRequest="320" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
