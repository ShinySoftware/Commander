@* Line icons in the app's style: 24-unit strokes, round joins, currentColor. *@
<svg class="icon @Class" viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "folder":
            <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
            break;
        case "folder-plus":
            <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><path d="M12 11v5M9.5 13.5h5" />
            break;
        case "file":
            <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" />
            break;
        case "image":
            <rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="9" cy="10" r="1.6" /><path d="m21 16-5-5-9 9" />
            break;
        case "film":
            <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M7 4v16M17 4v16M3 9h4M3 15h4M17 9h4M17 15h4" />
            break;
        case "music":
            <path d="M9 18V6l11-2v12" /><circle cx="6.5" cy="18" r="2.5" /><circle cx="17.5" cy="16" r="2.5" />
            break;
        case "archive":
            <rect x="3" y="4" width="18" height="5" rx="1" /><path d="M5 9v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9M10 13h4" />
            break;
        case "download":
            <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />
            break;
        case "upload":
            <path d="M12 20V9M7 14l5-5 5 5M5 4h14" />
            break;
        case "edit":
            <path d="M4 20h4L19 9l-4-4L4 16z" /><path d="m13.5 6.5 4 4" />
            break;
        case "trash":
            <path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3" />
            break;
        case "x":
            <path d="M6 6l12 12M18 6 6 18" />
            break;
        case "check":
            <path d="m5 12 5 5 9-10" />
            break;
        case "lock":
            <rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" />
            break;
        case "chevron":
            <path d="m9 6 6 6-6 6" />
            break;
        case "refresh":
            <path d="M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7" />
            break;
        case "inbox":
            <path d="M3 13h5l2 3h4l2-3h5" /><path d="M5 5h14l2 8v5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-5z" />
            break;
        case "alert":
            <circle cx="12" cy="12" r="9" /><path d="M12 8v5M12 16h.01" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 18;
    [Parameter] public string? Class { get; set; }

    /// <summary>The icon for a file name - by extension, like the app's own file list.</summary>
    public static string For(string name, bool directory)
    {
        if (directory)
            return "folder";

        return Path.GetExtension(name).ToLowerInvariant() switch
        {
            ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".heic" or ".bmp" or ".svg" or ".tif" or ".tiff" => "image",
            ".mp4" or ".mov" or ".mkv" or ".avi" or ".webm" or ".m4v" => "film",
            ".mp3" or ".m4a" or ".aac" or ".wav" or ".flac" or ".ogg" => "music",
            ".zip" or ".7z" or ".rar" or ".tar" or ".gz" or ".bz2" or ".xz" or ".zst" => "archive",
            _ => "file"
        };
    }
}
