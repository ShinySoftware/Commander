<Project Sdk="Microsoft.NET.Sdk">
    <!-- Windows head: standard .NET MAUI on WinUI 3 (unpackaged). Build on Windows. -->
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)-windows10.0.19041.0</TargetFramework>
        <OutputType>WinExe</OutputType>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <AssemblyName>ShinyCommander</AssemblyName>
        <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

        <ApplicationTitle>ShinyCommander</ApplicationTitle>
        <ApplicationId>org.shiny.commander</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <DefineConstants>$(DefineConstants);WINDOWS_WINUI</DefineConstants>
    </PropertyGroup>

    <Import Project="..\ShinyCommander.Shared\ShinyCommander.Shared.props" />

    <ItemGroup>
        <!-- the same tile as the macOS head; Resizetizer makes the exe's .ico from it (and fills $placeholder$ in
             Package.appxmanifest), so the installer's shortcuts and Add/Remove Programs show it -->
        <MauiIcon Include="..\ShinyCommander.Shared\Resources\AppIcon\appicon.png" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <PackageReference Include="Microsoft.Maui.DevFlow.Agent" />
    </ItemGroup>
</Project>
