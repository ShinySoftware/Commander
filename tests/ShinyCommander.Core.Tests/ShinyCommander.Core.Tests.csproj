<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>$(BaseTargetFramework)</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Shouldly" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Xunit" />
        <Using Include="Shouldly" />
    </ItemGroup>
    <ItemGroup>
        <!-- media, PDF and plist samples for FileMetadataReaderTests -->
        <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\ShinyCommander.Core\ShinyCommander.Core.csproj" />
        <ProjectReference Include="..\..\src\ShinyCommander.Remote\ShinyCommander.Remote.csproj" />
        <ProjectReference Include="..\..\src\ShinyCommander.Share\ShinyCommander.Share.csproj" />
    </ItemGroup>
</Project>
